          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# Upstream dtd.py expects vph_imagenet.pt and swin_imagenet.pt directly in models/\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"if vph_src.exists():\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    shutil.copyfile(vph_src, models_dir / \\\"vph_imagenet.pt\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    print(\\\"\342\234\223 Synced vph_imagenet.pt to models/\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"if swin_src.exists():\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    shutil.copyfile(swin_src, models_dir / \\\"swin_imagenet.pt\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    print(\\\"\342\234\223 Synced swin_imagenet.pt to models/\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"required_files = [\\\"dtd_doctamper.pth\\\", \\\"vph_imagenet.pt\\\", \\\"swin_imagenet.pt\\\", \\\"qt_table.pk\\\"]\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
