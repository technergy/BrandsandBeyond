          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"DOCTAMPER_WEIGHTS = str(DOCTAMPER_CHECKPOINT_DIR / \\\"dtd_doctamper.pth\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"DOCTAMPER_VPH_WEIGHTS = str(DOCTAMPER_CHECKPOINT_DIR / \\\"vph_imagenet.pt\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"DOCTAMPER_SWIN_WEIGHTS = str(DOCTAMPER_CHECKPOINT_DIR / \\\"swin_imagenet.pt\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"DOCTAMPER_QT_TABLE = str(DOCTAMPER_CHECKPOINT_DIR / \\\"qt_table.pk\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"_required = {\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    \\\"main\\\": Path(DOCTAMPER_WEIGHTS),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    \\\"vph\\\": Path(DOCTAMPER_VPH_WEIGHTS),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    \\\"swin\\\": Path(DOCTAMPER_SWIN_WEIGHTS),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    \\\"qt_table\\\": Path(DOCTAMPER_QT_TABLE),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
