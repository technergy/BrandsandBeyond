        }
        lines {
          text: "        \"## 18. Robustness: JPEG and resize/re-upload\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The perturbation is applied to the **held-out test images only**.\\n\","
