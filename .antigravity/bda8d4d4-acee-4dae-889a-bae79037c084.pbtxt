        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"AIForge-Doc v1 exposes provenance for the inpainting tool used for each forgery. The notebook reports detector performance by `assigned_tool` where enough samples are available.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
