        }
        lines {
          text: "              \"  cancel.textContent = \'Cancel upload\';\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"  const cancelPromise = new Promise((resolve) => {\\n\","
