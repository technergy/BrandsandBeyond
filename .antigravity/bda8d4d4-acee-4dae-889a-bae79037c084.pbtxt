          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"  }\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"  for (const file of files) {\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"    const li = document.createElement(\'li\');\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"    li.append(span(file.name, {fontWeight: \'bold\'}));\\n\","
