        }
        lines {
          text: "        \"        fp = int(np.sum((y_pred == 1) & (y_true_b == 0)))\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        fn = int(np.sum((y_pred == 0) & (y_true_b == 1)))\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        triples.append((tp, fp, fn))\\n\","
