        }
        lines {
          text: "        \"    Path(\\\"/content/drive/MyDrive/DocuForge/aiforge-doc.zip\\\"),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    Path(\\\"/content/drive/MyDrive/aiforge-doc.zip\\\"),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"]\\n\","
