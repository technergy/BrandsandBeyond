          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"    return {\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"      response: {\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"        action: \'complete\',\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"      }\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
