        lines {
          text: "        \"        # according to their official mapping.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        auth_cal=authentic_df[authentic_df.get(\\\"official_split\\\", authentic_df.get(\\\"split\\\", \\\"testing\\\")).astype(str).str.lower().isin([\\\"calibration\\\",\\\"train\\\",\\\"training\\\"])]\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        auth_test=authentic_df[authentic_df.get(\\\"official_split\\\", authentic_df.get(\\\"split\\\", \\\"testing\\\")).astype(str).str.lower().isin([\\\"testing\\\",\\\"test\\\"])]\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
