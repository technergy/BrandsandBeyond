        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"Detector-native prediction generation must be repeated on the perturbed images. The notebook does not reuse clean predictions for perturbed images because that would measure nothing.\\n\","
