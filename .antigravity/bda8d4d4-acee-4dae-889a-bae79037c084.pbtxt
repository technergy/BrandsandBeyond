        }
        lines {
          text: "              \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"  const cancel = document.createElement(\'button\');\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"  inputElement.parentElement.appendChild(cancel);\\n\","
