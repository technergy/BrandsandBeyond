          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# Final research status\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"### This notebook is a real-data benchmark harness.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The primary benchmark uses real AIForge-Doc images and official masks. TruFor and DocTamper remain external published baselines.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"For DocTamper, the notebook now contains an explicit zero-shot adapter around the published qcf-568 DTD implementation. It requires the trained checkpoint bundle before it will execute. Missing checkpoints are treated as an unavailable experiment, never as a reason to fabricate predictions.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The experimental sequence is:\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"1. authenticate to AIForge-Doc and use the completed `/content/aiforge-doc` dataset;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"2. stage the official TruFor and DocTamper repositories;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"3. supply authorized external detector checkpoints;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"4. run detector inference and normalize predictions;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"5. calibrate thresholds only on the official training-derived calibration split;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"6. evaluate the held-out official test split;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"7. run robustness/statistical/reporting cells.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"No numerical detector conclusion is valid until the corresponding real prediction files have been generated.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
