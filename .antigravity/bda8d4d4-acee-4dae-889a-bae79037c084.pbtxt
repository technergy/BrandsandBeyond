        lines {
          text: "      \"source\": ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# AI Document Counterfeiting Detection & Prevention \342\200\224 AI-Forge Research Benchmark v3\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"**Primary benchmark:** AIForge-Doc v1 (real diffusion-model document forgeries)  \\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"**External detectors:** TruFor and DocTamper  \\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"**Primary objective:** quantify how modern AI-inpainted document forgeries defeat established forensic detectors.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"This notebook deliberately **does not generate synthetic documents, synthetic attacks, or synthetic benchmark labels**. It also does not substitute a toy model when a real dataset or external detector is unavailable.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"> **Research-integrity rule:** a missing dataset, checkpoint, or prediction file is a hard stop for that experiment\342\200\224not a reason to fabricate or silently replace the input.\\n\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
