  run_command {
    cwd: "."
    exit_code: 0
    blocking: true
    wait_ms_before_async: 5000
    command_line: "cat << \'EOF\' > components/sections.tsx\n\'use client\';\n\nimport { motion, useMotionTemplate, useMotionValue } from \'motion/react\';\nimport Image from \'next/image\';\nimport { AnimatedNumber } from \'./ui\';\nimport React, { useRef } from \'react\';\n\nconst FadeUp = ({ children, delay = 0, className = \"\" }: { children: React.ReactNode, delay?: number, className?: string }) => (\n  <motion.div\n    initial={{ opacity: 0, y: 45, scale: 0.98 }}\n    whileInView={{ opacity: 1, y: 0, scale: 1 }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 0.75, delay, ease: \"easeOut\" }}\n    className={className}\n  >\n    {children}\n  </motion.div>\n);\n\nconst RevealHeading = ({ children, className = \"\" }: { children: React.ReactNode, className?: string }) => (\n  <motion.div\n    initial={{ y: 65, opacity: 0, clipPath: \"inset(18% 0 0 0)\" }}\n    whileInView={{ y: 0, opacity: 1, clipPath: \"inset(0% 0 0 0)\" }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}\n    className={className}\n  >\n    {children}\n  </motion.div>\n);\n\nconst SectionKicker = ({ children }: { children: React.ReactNode }) => (\n  <motion.div\n    initial={{ x: -28, opacity: 0 }}\n    whileInView={{ x: 0, opacity: 1 }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 0.7, ease: \"easeOut\" }}\n    className=\"font-cond text-[12px] font-bold tracking-widest uppercase text-brand-magenta mb-4\"\n  >\n    {children}\n  </motion.div>\n);\n\n// 3D Card effect component\nfunction TiltCard({ children, className = \"\" }: { children: React.ReactNode, className?: string }) {\n  const ref = useRef<HTMLDivElement>(null);\n  const mouseX = useMotionValue(0);\n  const mouseY = useMotionValue(0);\n\n  const rotateX = useMotionTemplate`${mouseY}deg`;\n  const rotateY = useMotionTemplate`${mouseX}deg`;\n\n  function handleMouseMove({ currentTarget, clientX, clientY }: React.MouseEvent) {\n    const { left, top, width, height } = currentTarget.getBoundingClientRect();\n    const x = (clientX - left - width / 2) / 25;\n    const y = -(clientY - top - height / 2) / 25;\n    mouseX.set(x);\n    mouseY.set(y);\n  }\n\n  function handleMouseLeave() {\n    mouseX.set(0);\n    mouseY.set(0);\n  }\n\n  return (\n    <motion.div\n      ref={ref}\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n      style={{ rotateX, rotateY, transformStyle: \"preserve-3d\" }}\n      className={`relative hover:shadow-[0_24px_55px_rgba(24,20,50,0.18)] transition-shadow duration-500 ${className}`}\n    >\n      {children}\n    </motion.div>\n  );\n}\n\nexport function Story() {\n  return (\n    <section id=\"story\" className=\"py-[75px] md:py-[110px] px-[6vw] md:px-[7vw] bg-brand-cream relative\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center\">\n        <FadeUp>\n          <SectionKicker>01 / About Brands &amp; Beyond</SectionKicker>\n          <RevealHeading>\n            <h2 className=\"font-cond font-extrabold text-[42px] sm:text-[50px] md:text-[clamp(42px,6vw,90px)] leading-[1.05] tracking-tight uppercase my-[18px]\">\n              Empowering<br/><span className=\"text-brand-magenta\">brands</span><br/>for what&apos;s <span className=\"text-[#2935a8]\">next.</span>\n            </h2>\n          </RevealHeading>\n          <p className=\"text-[14px] md:text-[15px] leading-[1.8] max-w-[480px] text-[#555663]\">\n            A platform for bold ideas, meaningful conversations and the people shaping a more innovative, inclusive and impactful tomorrow.\n          </p>\n          <div className=\"flex flex-col sm:flex-row gap-[12px] mt-[35px] max-w-[400px]\">\n            <a href=\"#people\" className=\"font-cond text-[11px] md:text-[13px] font-bold uppercase tracking-widest py-[14px] px-[24px] rounded-none border border-brand-magenta bg-brand-magenta text-white hover:bg-brand-pink hover:border-brand-pink transition-colors text-center\">\n              Explore speakers\n            </a>\n            <a href=\"#experience\" className=\"font-cond text-[11px] md:text-[13px] font-bold uppercase tracking-widest py-[14px] px-[24px] rounded-none border border-[#222] hover:bg-[#222] hover:text-white transition-colors text-center\">\n              Explore sessions\n            </a>\n          </div>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[320px] bg-[#11152d] rounded-none overflow-hidden group cursor-pointer shadow-lg border border-white/10\">\n            <Image src=\"https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&w=1200&q=85\" alt=\"Event video\" fill className=\"object-cover group-hover:scale-105 transition-transform duration-700\" referrerPolicy=\"no-referrer\" />\n            <div className=\"absolute inset-0 bg-gradient-to-b from-transparent to-[#0a0b1b]/65 via-transparent\" />\n            <motion.div \n              className=\"absolute left-[20px] bottom-[18px] w-[50px] h-[50px] rounded-none bg-brand-magenta flex items-center justify-center text-[15px] text-white z-10 border border-brand-pink\"\n              whileHover={{ scale: 1.1, backgroundColor: \"var(--color-brand-pink)\" }}\n            >\n              \342\226\266\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n      <div className=\"grid grid-cols-2 md:grid-cols-4 border-t border-[#d4d1cb] mt-[50px] md:mt-[85px] pt-[24px] gap-[20px]\">\n        <FadeUp delay={0.1} className=\"flex flex-col\"><AnimatedNumber value={10} suffix=\"+\" /><span className=\"font-cond font-bold text-[11px] tracking-widest uppercase text-[#777]\">Speakers</span></FadeUp>\n        <FadeUp delay={0.2} className=\"flex flex-col\"><AnimatedNumber value={10} suffix=\"+\" /><span className=\"font-cond font-bold text-[11px] tracking-widest uppercase text-[#777]\">Sessions</span></FadeUp>\n        <FadeUp delay={0.3} className=\"flex flex-col\"><AnimatedNumber value={20} suffix=\"+\" /><span className=\"font-cond font-bold text-[11px] tracking-widest uppercase text-[#777]\">Sponsors</span></FadeUp>\n        <FadeUp delay={0.4} className=\"flex flex-col\"><AnimatedNumber value={500} suffix=\"+\" /><span className=\"font-cond font-bold text-[11px] tracking-widest uppercase text-[#777]\">Delegates</span></FadeUp>\n      </div>\n    </section>\n  );\n}\n\nconst speakers = [\n  { img: \"https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=500&q=85\", name: \"Keynote Voice\", role: \"Brand Leader\" },\n  { img: \"https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=500&q=85\", name: \"Creative Voice\", role: \"Creative Director\" },\n  { img: \"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=500&q=85\", name: \"Growth Voice\", role: \"Business Leader\" },\n  { img: \"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=500&q=85\", name: \"Future Voice\", role: \"Strategist\" },\n  { img: \"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=500&q=85\", name: \"Culture Voice\", role: \"Founder\" },\n  { img: \"https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=500&q=85\", name: \"Impact Voice\", role: \"Entrepreneur\" },\n];\n\nconst advisors = [\n  { img: \"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=500&q=85\", name: \"Advisor One\", role: \"Industry\" },\n  { img: \"https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=500&q=85\", name: \"Advisor Two\", role: \"Brand\" },\n  { img: \"https://images.unsplash.com/photo-1504593811423-6dd665756598?auto=format&fit=crop&w=500&q=85\", name: \"Panel One\", role: \"Leadership\" },\n  { img: \"https://images.unsplash.com/photo-1504257432389-52343af06ae3?auto=format&fit=crop&w=500&q=85\", name: \"Panel Two\", role: \"Innovation\" },\n  { img: \"https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=500&q=85\", name: \"Panel Three\", role: \"Culture\" },\n  { img: \"https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=500&q=85\", name: \"Panel Four\", role: \"Growth\" },\n];\n\nexport function People() {\n  return (\n    <section id=\"people\" className=\"py-[75px] md:py-[110px] px-[6vw] md:px-[7vw] bg-[linear-gradient(145deg,#15164a,#252071_60%,#411c5d)] text-white relative overflow-hidden\">\n      <div className=\"absolute w-[70vw] h-[70vw] border border-brand-cyan/15 rounded-none -left-[25vw] -top-[10vw] rotate-45\" />\n      \n      <div className=\"relative text-center mb-[65px]\">\n        <SectionKicker><span className=\"text-brand-yellow\">02 / The voices</span></SectionKicker>\n        <RevealHeading>\n          <h2 className=\"font-cond font-extrabold text-[46px] md:text-[clamp(46px,7vw,95px)] leading-[1] tracking-tight uppercase m-0\">\n            People<br/>who move.\n          </h2>\n        </RevealHeading>\n      </div>\n\n      <div className=\"relative grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[60px] max-w-[1050px] mx-auto\">\n        <div>\n          <h3 className=\"font-cond text-[15px] md:text-[17px] font-bold tracking-widest uppercase border-b border-white/18 pb-[10px] m-0 mb-[22px]\">\n            Speakers <span className=\"text-brand-pink\">2025</span>\n          </h3>\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-[12px]\">\n            {speakers.map((person, i) => (\n              <FadeUp key={i} delay={i * 0.05}>\n                <motion.div \n                  className=\"bg-[#f7f5ef] rounded-none text-[#141525] p-[10px_10px_18px] text-center cursor-pointer shadow-none hover:shadow-[0_18px_35px_rgba(0,0,0,0.18)]\"\n                  whileHover={{ y: -8, rotate: -1 }}\n                  transition={{ type: \"spring\", stiffness: 300 }}\n                >\n                  <div className=\"w-full aspect-square relative overflow-hidden mb-3 rounded-none\">\n                    <Image src={person.img} alt={person.name} fill className=\"object-cover grayscale-[0.8]\" referrerPolicy=\"no-referrer\" />\n                  </div>\n                  <b className=\"block font-cond font-bold text-[12px] md:text-[13px] uppercase tracking-tight leading-tight\">{person.name}</b>\n                  <small className=\"text-[10px] text-[#7a7b84] font-sans block mt-1 leading-tight\">{person.role}</small>\n                </motion.div>\n              </FadeUp>\n            ))}\n          </div>\n        </div>\n\n        <div>\n          <h3 className=\"font-cond text-[15px] md:text-[17px] font-bold tracking-widest uppercase border-b border-white/18 pb-[10px] m-0 mb-[22px]\">\n            Advisors <span className=\"text-brand-pink\">+ Panels</span>\n          </h3>\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-[12px]\">\n            {advisors.map((person, i) => (\n              <FadeUp key={i} delay={0.2 + (i * 0.05)}>\n                <motion.div \n                  className=\"bg-[#f7f5ef] rounded-none text-[#141525] p-[10px_10px_18px] text-center cursor-pointer shadow-none hover:shadow-[0_18px_35px_rgba(0,0,0,0.18)]\"\n                  whileHover={{ y: -8, rotate: -1 }}\n                  transition={{ type: \"spring\", stiffness: 300 }}\n                >\n                  <div className=\"w-full aspect-square relative overflow-hidden mb-3 rounded-none\">\n                    <Image src={person.img} alt={person.name} fill className=\"object-cover grayscale-[0.8]\" referrerPolicy=\"no-referrer\" />\n                  </div>\n                  <b className=\"block font-cond font-bold text-[12px] md:text-[13px] uppercase tracking-tight leading-tight\">{person.name}</b>\n                  <small className=\"text-[10px] text-[#7a7b84] font-sans block mt-1 leading-tight\">{person.role}</small>\n                </motion.div>\n              </FadeUp>\n            ))}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport function Experience() {\n  return (\n    <section id=\"experience\" className=\"bg-white text-brand-ink px-[6vw] md:px-[7vw]\">\n      {/* Feature 1 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px] border-b border-[#ddd]\">\n        <FadeUp>\n          <SectionKicker>03 / Why participate?</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond font-extrabold text-[42px] leading-[1.1] uppercase tracking-tight my-[12px]\">Ideas that<br/>leave a mark.</h3></RevealHeading>\n          <p className=\"text-[14px] md:text-[15px] leading-[1.8] text-[#666] max-w-[470px]\">\n            Move beyond passive listening. Meet the people behind the ideas, challenge assumptions and build conversations that continue after the event.\n          </p>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[330px] rounded-none overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 rounded-none z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1200&q=85\" alt=\"Stage\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" referrerPolicy=\"no-referrer\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-none bg-brand-yellow text-[#111] font-cond font-bold text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 2.8, ease: \"easeInOut\", repeatType: \"reverse\" }}\n            >\n              CONNECT<br/>CREATE<br/>MOVE\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n\n      {/* Feature 2 (Reversed on md) */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px] border-b border-[#ddd]\">\n        <FadeUp delay={0.2} className=\"order-2 md:order-1\">\n          <TiltCard className=\"h-[330px] rounded-none overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 rounded-none z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1475721027785-f74eccf877e2?auto=format&fit=crop&w=1200&q=85\" alt=\"Masterclass\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" referrerPolicy=\"no-referrer\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-none bg-brand-cyan text-[#111] font-cond font-bold text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 3.15, ease: \"easeInOut\", repeatType: \"reverse\", delay: 0.5 }}\n            >\n              LEARN<br/>BUILD<br/>APPLY\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n        <FadeUp className=\"order-1 md:order-2\">\n          <SectionKicker>04 / Masterclass sessions</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond font-extrabold text-[42px] leading-[1.1] uppercase tracking-tight my-[12px]\">Go deeper.<br/>Make it real.</h3></RevealHeading>\n          <p className=\"text-[14px] md:text-[15px] leading-[1.8] text-[#666] max-w-[470px]\">\n            Focused sessions designed around practical knowledge, sharp perspectives and useful takeaways for the people building brands.\n          </p>\n        </FadeUp>\n      </div>\n\n      {/* Feature 3 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px]\">\n        <FadeUp>\n          <SectionKicker>05 / A musical session</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond font-extrabold text-[42px] leading-[1.1] uppercase tracking-tight my-[12px]\">Ideas have<br/>a rhythm.</h3></RevealHeading>\n          <p className=\"text-[14px] md:text-[15px] leading-[1.8] text-[#666] max-w-[470px]\">\n            A more human event experience: music, culture and unexpected moments woven between conversations.\n          </p>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[330px] rounded-none overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 rounded-none z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&w=1200&q=85\" alt=\"Music\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" referrerPolicy=\"no-referrer\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-none bg-brand-magenta text-white font-cond font-bold text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 3.5, ease: \"easeInOut\", repeatType: \"reverse\", delay: 1 }}\n            >\n              FEEL<br/>THE<br/>MOMENT\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n    </section>\n  );\n}\n\nexport function Audience() {\n  const chips = [\"Brand Leaders\", \"Marketing Teams\", \"Creative Directors\", \"Founders\", \"Entrepreneurs\", \"Strategists\", \"Product Leaders\", \"Young Professionals\"];\n  \n  return (\n    <section className=\"bg-[linear-gradient(135deg,#b91693,#e42eb3)] text-white text-center py-[100px] px-[7vw] relative overflow-hidden\">\n      <SectionKicker><span className=\"text-brand-yellow\">06 / Who should attend?</span></SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond font-extrabold text-[46px] md:text-[64px] leading-[1] uppercase tracking-tight my-[15px] mb-[35px]\">\n          Built for people<br/>who move.\n        </h2>\n      </RevealHeading>\n      <div className=\"flex flex-wrap justify-center gap-[8px] max-w-[850px] mx-auto\">\n        {chips.map((chip, i) => (\n          <motion.span\n            key={chip}\n            initial={{ y: 22, opacity: 0, scale: 0.92 }}\n            whileInView={{ y: 0, opacity: 1, scale: 1 }}\n            viewport={{ once: true, margin: \"-10%\" }}\n            transition={{ duration: 0.5, delay: i * 0.055, type: \"spring\", bounce: 0.4 }}\n            whileHover={{ y: -3, backgroundColor: \"#ffffff\", color: \"var(--color-brand-purple)\" }}\n            className=\"border border-white/65 rounded-none py-[10px] px-[16px] font-cond font-bold text-[12px] uppercase tracking-widest cursor-pointer transition-colors duration-300\"\n          >\n            {chip}\n          </motion.span>\n        ))}\n      </div>\n    </section>\n  );\n}\n\nexport function Schedule() {\n  const schedule = [\n    { time: \"09:00\", session: \"Registration & Networking\", track: \"Community\" },\n    { time: \"10:00\", session: \"Opening Keynote\", track: \"Ideas\" },\n    { time: \"11:30\", session: \"Brand Transformation\", track: \"Brands\" },\n    { time: \"13:00\", session: \"Lunch & Connections\", track: \"Community\" },\n    { time: \"14:30\", session: \"Masterclass Sessions\", track: \"Deep Dive\" },\n    { time: \"16:30\", session: \"Panel: What\'s Next?\", track: \"Future\" },\n  ];\n\n  return (\n    <section className=\"bg-brand-cream py-[75px] md:py-[110px] px-[6vw] md:px-[7vw]\">\n      <SectionKicker>08 / Event schedule</SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond font-extrabold text-[42px] md:text-[56px] uppercase leading-[1] tracking-tight my-[15px] mb-[45px]\">\n          Two days.<br/>One movement.\n        </h2>\n      </RevealHeading>\n      <div className=\"max-w-[950px] mx-auto border border-[#ddd] bg-white\">\n        <div className=\"grid grid-cols-[1fr_2fr_1fr] p-[14px_18px] border-b border-[#e2e2e2] font-cond font-bold text-[12px] bg-brand-purple text-white uppercase tracking-widest\">\n          <div>Time</div><div>Session</div><div>Track</div>\n        </div>\n        {schedule.map((row, i) => (\n          <FadeUp key={i} delay={i * 0.05}>\n            <div className=\"grid grid-cols-[1fr_2fr_1fr] p-[14px_18px] border-b border-[#e2e2e2] font-cond text-[13px] hover:bg-[#fafafa] transition-colors last:border-b-0\">\n              <div className=\"flex items-center text-[#555]\">{row.time}</div>\n              <div className=\"font-bold flex items-center text-[14px] md:text-[15px]\">{row.session}</div>\n              <div className=\"text-[#888] flex items-center uppercase tracking-widest text-[11px] font-bold\">{row.track}</div>\n            </div>\n          </FadeUp>\n        ))}\n      </div>\n    </section>\n  );\n}\n\nexport function Packages() {\n  return (\n    <section id=\"packages\" className=\"bg-white py-[75px] md:py-[110px] px-[6vw] md:px-[7vw]\">\n      <SectionKicker>07 / Delegate packages</SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond font-extrabold text-[42px] md:text-[56px] uppercase leading-[1] tracking-tight my-[15px] mb-[45px]\">\n          Choose your<br/>way in.\n        </h2>\n      </RevealHeading>\n      \n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-[24px]\">\n        <FadeUp delay={0.1}>\n          <motion.div \n            className=\"p-[40px_30px] rounded-none relative overflow-hidden bg-[#ff9b00] text-white shadow-transparent cursor-pointer border border-[#ff9b00]\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(255,155,0,0.3)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] font-extrabold uppercase m-0 tracking-tight\">Standard</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 18,000</div>\n            <p className=\"text-[14px] md:text-[15px] leading-[1.6] opacity-90 mb-[30px]\">Full event access, sessions, networking and delegate materials.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[12px_24px] font-cond font-bold text-[12px] uppercase mt-[15px] hover:bg-white hover:text-[#ff9b00] transition-colors whitespace-nowrap\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n\n        <FadeUp delay={0.2}>\n          <motion.div \n            className=\"p-[40px_30px] rounded-none relative overflow-hidden bg-[#14b97b] text-white shadow-transparent cursor-pointer border border-[#14b97b]\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(20,185,123,0.3)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] font-extrabold uppercase m-0 tracking-tight\">Premium</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 24,000</div>\n            <p className=\"text-[14px] md:text-[15px] leading-[1.6] opacity-90 mb-[30px]\">Priority seating, premium networking access and additional experiences.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[12px_24px] font-cond font-bold text-[12px] uppercase mt-[15px] hover:bg-white hover:text-[#14b97b] transition-colors whitespace-nowrap\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n\n        <FadeUp delay={0.3}>\n          <motion.div \n            className=\"p-[40px_30px] rounded-none relative overflow-hidden bg-[#2782e7] text-white shadow-transparent cursor-pointer border border-[#2782e7]\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(39,130,231,0.3)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] font-extrabold uppercase m-0 tracking-tight\">VIP</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 35,000</div>\n            <p className=\"text-[14px] md:text-[15px] leading-[1.6] opacity-90 mb-[30px]\">VIP access, premium hospitality and high-level networking opportunities.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[12px_24px] font-cond font-bold text-[12px] uppercase mt-[15px] hover:bg-white hover:text-[#2782e7] transition-colors whitespace-nowrap\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n      </div>\n    </section>\n  );\n}\nEOF\n"
    proposed_command_line: "cat << \'EOF\' > components/sections.tsx\n\'use client\';\n\nimport { motion, useMotionTemplate, useMotionValue } from \'motion/react\';\nimport Image from \'next/image\';\nimport { AnimatedNumber } from \'./ui\';\nimport React, { useRef } from \'react\';\n\nconst FadeUp = ({ children, delay = 0, className = \"\" }: { children: React.ReactNode, delay?: number, className?: string }) => (\n  <motion.div\n    initial={{ opacity: 0, y: 45, scale: 0.98 }}\n    whileInView={{ opacity: 1, y: 0, scale: 1 }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 0.75, delay, ease: \"easeOut\" }}\n    className={className}\n  >\n    {children}\n  </motion.div>\n);\n\nconst RevealHeading = ({ children, className = \"\" }: { children: React.ReactNode, className?: string }) => (\n  <motion.div\n    initial={{ y: 65, opacity: 0, clipPath: \"inset(18% 0 0 0)\" }}\n    whileInView={{ y: 0, opacity: 1, clipPath: \"inset(0% 0 0 0)\" }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}\n    className={className}\n  >\n    {children}\n  </motion.div>\n);\n\nconst SectionKicker = ({ children }: { children: React.ReactNode }) => (\n  <motion.div\n    initial={{ x: -28, opacity: 0 }}\n    whileInView={{ x: 0, opacity: 1 }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 0.7, ease: \"easeOut\" }}\n    className=\"font-cond text-[12px] font-bold tracking-widest uppercase text-brand-magenta mb-4\"\n  >\n    {children}\n  </motion.div>\n);\n\n// 3D Card effect component\nfunction TiltCard({ children, className = \"\" }: { children: React.ReactNode, className?: string }) {\n  const ref = useRef<HTMLDivElement>(null);\n  const mouseX = useMotionValue(0);\n  const mouseY = useMotionValue(0);\n\n  const rotateX = useMotionTemplate`${mouseY}deg`;\n  const rotateY = useMotionTemplate`${mouseX}deg`;\n\n  function handleMouseMove({ currentTarget, clientX, clientY }: React.MouseEvent) {\n    const { left, top, width, height } = currentTarget.getBoundingClientRect();\n    const x = (clientX - left - width / 2) / 25;\n    const y = -(clientY - top - height / 2) / 25;\n    mouseX.set(x);\n    mouseY.set(y);\n  }\n\n  function handleMouseLeave() {\n    mouseX.set(0);\n    mouseY.set(0);\n  }\n\n  return (\n    <motion.div\n      ref={ref}\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n      style={{ rotateX, rotateY, transformStyle: \"preserve-3d\" }}\n      className={`relative hover:shadow-[0_24px_55px_rgba(24,20,50,0.18)] transition-shadow duration-500 ${className}`}\n    >\n      {children}\n    </motion.div>\n  );\n}\n\nexport function Story() {\n  return (\n    <section id=\"story\" className=\"py-[75px] md:py-[110px] px-[6vw] md:px-[7vw] bg-brand-cream relative\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center\">\n        <FadeUp>\n          <SectionKicker>01 / About Brands &amp; Beyond</SectionKicker>\n          <RevealHeading>\n            <h2 className=\"font-cond font-extrabold text-[42px] sm:text-[50px] md:text-[clamp(42px,6vw,90px)] leading-[1.05] tracking-tight uppercase my-[18px]\">\n              Empowering<br/><span className=\"text-brand-magenta\">brands</span><br/>for what&apos;s <span className=\"text-[#2935a8]\">next.</span>\n            </h2>\n          </RevealHeading>\n          <p className=\"text-[14px] md:text-[15px] leading-[1.8] max-w-[480px] text-[#555663]\">\n            A platform for bold ideas, meaningful conversations and the people shaping a more innovative, inclusive and impactful tomorrow.\n          </p>\n          <div className=\"flex flex-col sm:flex-row gap-[12px] mt-[35px] max-w-[400px]\">\n            <a href=\"#people\" className=\"font-cond text-[11px] md:text-[13px] font-bold uppercase tracking-widest py-[14px] px-[24px] rounded-none border border-brand-magenta bg-brand-magenta text-white hover:bg-brand-pink hover:border-brand-pink transition-colors text-center\">\n              Explore speakers\n            </a>\n            <a href=\"#experience\" className=\"font-cond text-[11px] md:text-[13px] font-bold uppercase tracking-widest py-[14px] px-[24px] rounded-none border border-[#222] hover:bg-[#222] hover:text-white transition-colors text-center\">\n              Explore sessions\n            </a>\n          </div>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[320px] bg-[#11152d] rounded-none overflow-hidden group cursor-pointer shadow-lg border border-white/10\">\n            <Image src=\"https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&w=1200&q=85\" alt=\"Event video\" fill className=\"object-cover group-hover:scale-105 transition-transform duration-700\" referrerPolicy=\"no-referrer\" />\n            <div className=\"absolute inset-0 bg-gradient-to-b from-transparent to-[#0a0b1b]/65 via-transparent\" />\n            <motion.div \n              className=\"absolute left-[20px] bottom-[18px] w-[50px] h-[50px] rounded-none bg-brand-magenta flex items-center justify-center text-[15px] text-white z-10 border border-brand-pink\"\n              whileHover={{ scale: 1.1, backgroundColor: \"var(--color-brand-pink)\" }}\n            >\n              \342\226\266\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n      <div className=\"grid grid-cols-2 md:grid-cols-4 border-t border-[#d4d1cb] mt-[50px] md:mt-[85px] pt-[24px] gap-[20px]\">\n        <FadeUp delay={0.1} className=\"flex flex-col\"><AnimatedNumber value={10} suffix=\"+\" /><span className=\"font-cond font-bold text-[11px] tracking-widest uppercase text-[#777]\">Speakers</span></FadeUp>\n        <FadeUp delay={0.2} className=\"flex flex-col\"><AnimatedNumber value={10} suffix=\"+\" /><span className=\"font-cond font-bold text-[11px] tracking-widest uppercase text-[#777]\">Sessions</span></FadeUp>\n        <FadeUp delay={0.3} className=\"flex flex-col\"><AnimatedNumber value={20} suffix=\"+\" /><span className=\"font-cond font-bold text-[11px] tracking-widest uppercase text-[#777]\">Sponsors</span></FadeUp>\n        <FadeUp delay={0.4} className=\"flex flex-col\"><AnimatedNumber value={500} suffix=\"+\" /><span className=\"font-cond font-bold text-[11px] tracking-widest uppercase text-[#777]\">Delegates</span></FadeUp>\n      </div>\n    </section>\n  );\n}\n\nconst speakers = [\n  { img: \"https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=500&q=85\", name: \"Keynote Voice\", role: \"Brand Leader\" },\n  { img: \"https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=500&q=85\", name: \"Creative Voice\", role: \"Creative Director\" },\n  { img: \"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=500&q=85\", name: \"Growth Voice\", role: \"Business Leader\" },\n  { img: \"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=500&q=85\", name: \"Future Voice\", role: \"Strategist\" },\n  { img: \"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=500&q=85\", name: \"Culture Voice\", role: \"Founder\" },\n  { img: \"https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=500&q=85\", name: \"Impact Voice\", role: \"Entrepreneur\" },\n];\n\nconst advisors = [\n  { img: \"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=500&q=85\", name: \"Advisor One\", role: \"Industry\" },\n  { img: \"https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=500&q=85\", name: \"Advisor Two\", role: \"Brand\" },\n  { img: \"https://images.unsplash.com/photo-1504593811423-6dd665756598?auto=format&fit=crop&w=500&q=85\", name: \"Panel One\", role: \"Leadership\" },\n  { img: \"https://images.unsplash.com/photo-1504257432389-52343af06ae3?auto=format&fit=crop&w=500&q=85\", name: \"Panel Two\", role: \"Innovation\" },\n  { img: \"https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=500&q=85\", name: \"Panel Three\", role: \"Culture\" },\n  { img: \"https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=500&q=85\", name: \"Panel Four\", role: \"Growth\" },\n];\n\nexport function People() {\n  return (\n    <section id=\"people\" className=\"py-[75px] md:py-[110px] px-[6vw] md:px-[7vw] bg-[linear-gradient(145deg,#15164a,#252071_60%,#411c5d)] text-white relative overflow-hidden\">\n      <div className=\"absolute w-[70vw] h-[70vw] border border-brand-cyan/15 rounded-none -left-[25vw] -top-[10vw] rotate-45\" />\n      \n      <div className=\"relative text-center mb-[65px]\">\n        <SectionKicker><span className=\"text-brand-yellow\">02 / The voices</span></SectionKicker>\n        <RevealHeading>\n          <h2 className=\"font-cond font-extrabold text-[46px] md:text-[clamp(46px,7vw,95px)] leading-[1] tracking-tight uppercase m-0\">\n            People<br/>who move.\n          </h2>\n        </RevealHeading>\n      </div>\n\n      <div className=\"relative grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[60px] max-w-[1050px] mx-auto\">\n        <div>\n          <h3 className=\"font-cond text-[15px] md:text-[17px] font-bold tracking-widest uppercase border-b border-white/18 pb-[10px] m-0 mb-[22px]\">\n            Speakers <span className=\"text-brand-pink\">2025</span>\n          </h3>\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-[12px]\">\n            {speakers.map((person, i) => (\n              <FadeUp key={i} delay={i * 0.05}>\n                <motion.div \n                  className=\"bg-[#f7f5ef] rounded-none text-[#141525] p-[10px_10px_18px] text-center cursor-pointer shadow-none hover:shadow-[0_18px_35px_rgba(0,0,0,0.18)]\"\n                  whileHover={{ y: -8, rotate: -1 }}\n                  transition={{ type: \"spring\", stiffness: 300 }}\n                >\n                  <div className=\"w-full aspect-square relative overflow-hidden mb-3 rounded-none\">\n                    <Image src={person.img} alt={person.name} fill className=\"object-cover grayscale-[0.8]\" referrerPolicy=\"no-referrer\" />\n                  </div>\n                  <b className=\"block font-cond font-bold text-[12px] md:text-[13px] uppercase tracking-tight leading-tight\">{person.name}</b>\n                  <small className=\"text-[10px] text-[#7a7b84] font-sans block mt-1 leading-tight\">{person.role}</small>\n                </motion.div>\n              </FadeUp>\n            ))}\n          </div>\n        </div>\n\n        <div>\n          <h3 className=\"font-cond text-[15px] md:text-[17px] font-bold tracking-widest uppercase border-b border-white/18 pb-[10px] m-0 mb-[22px]\">\n            Advisors <span className=\"text-brand-pink\">+ Panels</span>\n          </h3>\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-[12px]\">\n            {advisors.map((person, i) => (\n              <FadeUp key={i} delay={0.2 + (i * 0.05)}>\n                <motion.div \n                  className=\"bg-[#f7f5ef] rounded-none text-[#141525] p-[10px_10px_18px] text-center cursor-pointer shadow-none hover:shadow-[0_18px_35px_rgba(0,0,0,0.18)]\"\n                  whileHover={{ y: -8, rotate: -1 }}\n                  transition={{ type: \"spring\", stiffness: 300 }}\n                >\n                  <div className=\"w-full aspect-square relative overflow-hidden mb-3 rounded-none\">\n                    <Image src={person.img} alt={person.name} fill className=\"object-cover grayscale-[0.8]\" referrerPolicy=\"no-referrer\" />\n                  </div>\n                  <b className=\"block font-cond font-bold text-[12px] md:text-[13px] uppercase tracking-tight leading-tight\">{person.name}</b>\n                  <small className=\"text-[10px] text-[#7a7b84] font-sans block mt-1 leading-tight\">{person.role}</small>\n                </motion.div>\n              </FadeUp>\n            ))}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport function Experience() {\n  return (\n    <section id=\"experience\" className=\"bg-white text-brand-ink px-[6vw] md:px-[7vw]\">\n      {/* Feature 1 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px] border-b border-[#ddd]\">\n        <FadeUp>\n          <SectionKicker>03 / Why participate?</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond font-extrabold text-[42px] leading-[1.1] uppercase tracking-tight my-[12px]\">Ideas that<br/>leave a mark.</h3></RevealHeading>\n          <p className=\"text-[14px] md:text-[15px] leading-[1.8] text-[#666] max-w-[470px]\">\n            Move beyond passive listening. Meet the people behind the ideas, challenge assumptions and build conversations that continue after the event.\n          </p>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[330px] rounded-none overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 rounded-none z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1200&q=85\" alt=\"Stage\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" referrerPolicy=\"no-referrer\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-none bg-brand-yellow text-[#111] font-cond font-bold text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 2.8, ease: \"easeInOut\", repeatType: \"reverse\" }}\n            >\n              CONNECT<br/>CREATE<br/>MOVE\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n\n      {/* Feature 2 (Reversed on md) */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px] border-b border-[#ddd]\">\n        <FadeUp delay={0.2} className=\"order-2 md:order-1\">\n          <TiltCard className=\"h-[330px] rounded-none overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 rounded-none z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1475721027785-f74eccf877e2?auto=format&fit=crop&w=1200&q=85\" alt=\"Masterclass\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" referrerPolicy=\"no-referrer\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-none bg-brand-cyan text-[#111] font-cond font-bold text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 3.15, ease: \"easeInOut\", repeatType: \"reverse\", delay: 0.5 }}\n            >\n              LEARN<br/>BUILD<br/>APPLY\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n        <FadeUp className=\"order-1 md:order-2\">\n          <SectionKicker>04 / Masterclass sessions</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond font-extrabold text-[42px] leading-[1.1] uppercase tracking-tight my-[12px]\">Go deeper.<br/>Make it real.</h3></RevealHeading>\n          <p className=\"text-[14px] md:text-[15px] leading-[1.8] text-[#666] max-w-[470px]\">\n            Focused sessions designed around practical knowledge, sharp perspectives and useful takeaways for the people building brands.\n          </p>\n        </FadeUp>\n      </div>\n\n      {/* Feature 3 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px]\">\n        <FadeUp>\n          <SectionKicker>05 / A musical session</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond font-extrabold text-[42px] leading-[1.1] uppercase tracking-tight my-[12px]\">Ideas have<br/>a rhythm.</h3></RevealHeading>\n          <p className=\"text-[14px] md:text-[15px] leading-[1.8] text-[#666] max-w-[470px]\">\n            A more human event experience: music, culture and unexpected moments woven between conversations.\n          </p>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[330px] rounded-none overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 rounded-none z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&w=1200&q=85\" alt=\"Music\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" referrerPolicy=\"no-referrer\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-none bg-brand-magenta text-white font-cond font-bold text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 3.5, ease: \"easeInOut\", repeatType: \"reverse\", delay: 1 }}\n            >\n              FEEL<br/>THE<br/>MOMENT\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n    </section>\n  );\n}\n\nexport function Audience() {\n  const chips = [\"Brand Leaders\", \"Marketing Teams\", \"Creative Directors\", \"Founders\", \"Entrepreneurs\", \"Strategists\", \"Product Leaders\", \"Young Professionals\"];\n  \n  return (\n    <section className=\"bg-[linear-gradient(135deg,#b91693,#e42eb3)] text-white text-center py-[100px] px-[7vw] relative overflow-hidden\">\n      <SectionKicker><span className=\"text-brand-yellow\">06 / Who should attend?</span></SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond font-extrabold text-[46px] md:text-[64px] leading-[1] uppercase tracking-tight my-[15px] mb-[35px]\">\n          Built for people<br/>who move.\n        </h2>\n      </RevealHeading>\n      <div className=\"flex flex-wrap justify-center gap-[8px] max-w-[850px] mx-auto\">\n        {chips.map((chip, i) => (\n          <motion.span\n            key={chip}\n            initial={{ y: 22, opacity: 0, scale: 0.92 }}\n            whileInView={{ y: 0, opacity: 1, scale: 1 }}\n            viewport={{ once: true, margin: \"-10%\" }}\n            transition={{ duration: 0.5, delay: i * 0.055, type: \"spring\", bounce: 0.4 }}\n            whileHover={{ y: -3, backgroundColor: \"#ffffff\", color: \"var(--color-brand-purple)\" }}\n            className=\"border border-white/65 rounded-none py-[10px] px-[16px] font-cond font-bold text-[12px] uppercase tracking-widest cursor-pointer transition-colors duration-300\"\n          >\n            {chip}\n          </motion.span>\n        ))}\n      </div>\n    </section>\n  );\n}\n\nexport function Schedule() {\n  const schedule = [\n    { time: \"09:00\", session: \"Registration & Networking\", track: \"Community\" },\n    { time: \"10:00\", session: \"Opening Keynote\", track: \"Ideas\" },\n    { time: \"11:30\", session: \"Brand Transformation\", track: \"Brands\" },\n    { time: \"13:00\", session: \"Lunch & Connections\", track: \"Community\" },\n    { time: \"14:30\", session: \"Masterclass Sessions\", track: \"Deep Dive\" },\n    { time: \"16:30\", session: \"Panel: What\'s Next?\", track: \"Future\" },\n  ];\n\n  return (\n    <section className=\"bg-brand-cream py-[75px] md:py-[110px] px-[6vw] md:px-[7vw]\">\n      <SectionKicker>08 / Event schedule</SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond font-extrabold text-[42px] md:text-[56px] uppercase leading-[1] tracking-tight my-[15px] mb-[45px]\">\n          Two days.<br/>One movement.\n        </h2>\n      </RevealHeading>\n      <div className=\"max-w-[950px] mx-auto border border-[#ddd] bg-white\">\n        <div className=\"grid grid-cols-[1fr_2fr_1fr] p-[14px_18px] border-b border-[#e2e2e2] font-cond font-bold text-[12px] bg-brand-purple text-white uppercase tracking-widest\">\n          <div>Time</div><div>Session</div><div>Track</div>\n        </div>\n        {schedule.map((row, i) => (\n          <FadeUp key={i} delay={i * 0.05}>\n            <div className=\"grid grid-cols-[1fr_2fr_1fr] p-[14px_18px] border-b border-[#e2e2e2] font-cond text-[13px] hover:bg-[#fafafa] transition-colors last:border-b-0\">\n              <div className=\"flex items-center text-[#555]\">{row.time}</div>\n              <div className=\"font-bold flex items-center text-[14px] md:text-[15px]\">{row.session}</div>\n              <div className=\"text-[#888] flex items-center uppercase tracking-widest text-[11px] font-bold\">{row.track}</div>\n            </div>\n          </FadeUp>\n        ))}\n      </div>\n    </section>\n  );\n}\n\nexport function Packages() {\n  return (\n    <section id=\"packages\" className=\"bg-white py-[75px] md:py-[110px] px-[6vw] md:px-[7vw]\">\n      <SectionKicker>07 / Delegate packages</SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond font-extrabold text-[42px] md:text-[56px] uppercase leading-[1] tracking-tight my-[15px] mb-[45px]\">\n          Choose your<br/>way in.\n        </h2>\n      </RevealHeading>\n      \n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-[24px]\">\n        <FadeUp delay={0.1}>\n          <motion.div \n            className=\"p-[40px_30px] rounded-none relative overflow-hidden bg-[#ff9b00] text-white shadow-transparent cursor-pointer border border-[#ff9b00]\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(255,155,0,0.3)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] font-extrabold uppercase m-0 tracking-tight\">Standard</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 18,000</div>\n            <p className=\"text-[14px] md:text-[15px] leading-[1.6] opacity-90 mb-[30px]\">Full event access, sessions, networking and delegate materials.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[12px_24px] font-cond font-bold text-[12px] uppercase mt-[15px] hover:bg-white hover:text-[#ff9b00] transition-colors whitespace-nowrap\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n\n        <FadeUp delay={0.2}>\n          <motion.div \n            className=\"p-[40px_30px] rounded-none relative overflow-hidden bg-[#14b97b] text-white shadow-transparent cursor-pointer border border-[#14b97b]\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(20,185,123,0.3)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] font-extrabold uppercase m-0 tracking-tight\">Premium</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 24,000</div>\n            <p className=\"text-[14px] md:text-[15px] leading-[1.6] opacity-90 mb-[30px]\">Priority seating, premium networking access and additional experiences.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[12px_24px] font-cond font-bold text-[12px] uppercase mt-[15px] hover:bg-white hover:text-[#14b97b] transition-colors whitespace-nowrap\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n\n        <FadeUp delay={0.3}>\n          <motion.div \n            className=\"p-[40px_30px] rounded-none relative overflow-hidden bg-[#2782e7] text-white shadow-transparent cursor-pointer border border-[#2782e7]\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(39,130,231,0.3)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] font-extrabold uppercase m-0 tracking-tight\">VIP</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 35,000</div>\n            <p className=\"text-[14px] md:text-[15px] leading-[1.6] opacity-90 mb-[30px]\">VIP access, premium hospitality and high-level networking opportunities.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[12px_24px] font-cond font-bold text-[12px] uppercase mt-[15px] hover:bg-white hover:text-[#2782e7] transition-colors whitespace-nowrap\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n      </div>\n    </section>\n  );\n}\nEOF\n"
    shell_name: "bash"
  }
}
