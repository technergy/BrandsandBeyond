          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    for r in tqdm(df.itertuples(index=False),total=len(df),desc=kind):\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        img=Image.open(r.image_path).convert(\\\"RGB\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        if kind==\\\"jpeg_q50\\\":\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"            new=perturb_jpeg(img,CFG.jpeg_quality)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
