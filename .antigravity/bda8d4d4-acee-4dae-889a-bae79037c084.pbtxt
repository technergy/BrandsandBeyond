          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"## 22. Six-agent forensic system \342\200\224 now explicitly secondary\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The original multi-agent system is **not allowed to contaminate the primary benchmark**.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"If OCR, ELA/copy-move, biometric, cryptographic, or other agents are later evaluated, they are reported as a separate engineered-system experiment.\\n\","
