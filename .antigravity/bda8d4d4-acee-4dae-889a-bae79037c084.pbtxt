        }
        lines {
          text: "        \"## 15. Evaluate one detector\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"Calibration is performed only against the calibration portion of the real benchmark.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The test threshold is then frozen.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"For image-level classification, an authentic-control set is mandatory. If one is not available in the supplied files/mapping, the notebook reports localization metrics and forged-only detector scores but refuses to invent a negative class.\\n\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
