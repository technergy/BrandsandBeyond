\n                href=\"#packages\" \n                className=\"font-sans text-[13px] font-bold uppercase tracking-widest p-[16px_32px] rounded-none border border-brand-magenta bg-brand-magenta hover:bg-brand-pink hover:border-brand-pink transition-all whitespace-nowrap\"\n              >\n                Register now\n              </a>\n            </motion.div>\n          </div>\n        </motion.div>\n\n        <motion.div style={{ y: rightY }} className=\"absolute md:relative w-[30%] md:w-full h-[75%] md:h-full top-[15%] md:top-0 right-[-5%] md:right-0 opacity-40 md:opacity-100 overflow-hidden before:content-[\'\'] before:absolute before:inset-0 before:z-[3] before:pointer-events-none before:bg-[linear-gradient(90deg,rgba(15,16,38,0.7),transparent_20%,transparent_80%,#0f1026)]\">\n          <HeroColumn items={rightCards} direction=\"down\" speed={27} className=\"md:items-start right-[3%] md:left-[10%] top-0 md:top-[-30%]\" />\n        </motion.div>\n      </div>\n    </section>\n  );\n}\nEOF"
