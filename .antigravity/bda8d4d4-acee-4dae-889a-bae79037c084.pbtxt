        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"AIForge-Doc v1 is a gated academic/non-commercial dataset. The dataset card documents 4,061 forged images, official training/testing directories, pixel masks, provenance metadata, two inpainting tools, and four source document datasets.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
