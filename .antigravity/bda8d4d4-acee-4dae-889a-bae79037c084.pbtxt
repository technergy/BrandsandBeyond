          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"id\": \"zjHqKu_76012\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"metadata\": {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"id\": \"zjHqKu_76012\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      },"
