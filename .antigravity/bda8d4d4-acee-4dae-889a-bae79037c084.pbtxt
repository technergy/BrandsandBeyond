        }
        lines {
          text: "      \"source\": ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"### DocTamper execution adapter\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"When the required checkpoint bundle is present, the next cell runs the **published qcf-568 DTD model architecture** directly and converts its output into the benchmark\'s normalized `sample_id,image_score,mask_npy_path` schema.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The adapter:\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"- uses JPEG quality 75, matching the published DocTamper evaluation path;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"- supplies RGB + JPEG DCT coefficients + the JPEG quantization table;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"- keeps the original AIForge image dimensions for evaluation;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"- uses the model\'s continuous tamper-class probability for pixel AP/AUC;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"- derives `image_score` as the fraction of pixels with tamper probability \342\211\245 0.5;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"- never trains or fine-tunes DocTamper on AIForge-Doc;\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"- stops explicitly if the checkpoint bundle is missing.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
