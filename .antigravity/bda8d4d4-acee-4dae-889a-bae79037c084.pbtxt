        }
        lines {
          text: "        \"## 10. TruFor adapter\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"Official repository: `grip-unina/TruFor`.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The repository provides inference/test code and a pixel-level localization map plus whole-image integrity score. Model weights are a separate dependency and must be supplied according to the repository\'s current instructions.\\n\","
