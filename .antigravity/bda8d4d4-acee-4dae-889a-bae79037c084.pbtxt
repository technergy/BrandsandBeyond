        }
        lines {
          text: "        \"# 22. Secondary-system placeholder\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"SECONDARY_AGENT_POLICY = {\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    \\\"primary_benchmark\\\": [\\\"TruFor\\\",\\\"DocTamper\\\"],\\n\","
