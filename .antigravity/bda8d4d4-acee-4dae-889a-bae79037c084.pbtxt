          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    merged=test_forged.merge(pred_df,on=\\\"sample_id\\\",validate=\\\"many_to_one\\\")\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
