        lines {
          text: "        \"# 4. Build the canonical manifest from official metadata\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"root = Path(CFG.dataset_dir)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"meta_path = root / \\\"metadata.jsonl\\\"\\n\","
