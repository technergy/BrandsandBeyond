          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"outputs\": [],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"source\": ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"def compute_image_triples(targets, scores, threshold):\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    triples = []\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    for y_true, y_score in zip(targets, scores):\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
