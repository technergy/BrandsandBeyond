        }
        lines {
          text: "        \"]\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"if not (dataset_target / \\\"metadata.jsonl\\\").exists():\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    print(\\\"AIForge-Doc dataset not found at /content/aiforge-doc. Acquiring...\\\")\\n\","
