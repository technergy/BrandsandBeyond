          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"    const fileDataPromise = new Promise((resolve) => {\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"      const reader = new FileReader();\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
