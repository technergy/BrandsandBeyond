          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      onMouseMove={handleMouseMove}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      onMouseLeave={handleMouseLeave}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
