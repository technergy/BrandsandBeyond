        lines {
          text: "        \"    for y_true, y_score in zip(targets, scores):\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        y_pred = (y_score >= threshold).astype(np.uint8)\\n\","
