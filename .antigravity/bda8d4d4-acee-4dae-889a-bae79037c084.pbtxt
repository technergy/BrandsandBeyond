    description: "cat << \'EOF\' > app/layout.tsx\nimport type {Metadata} from \'next\';\nimport { Space_Grotesk, Sora } from \'next/font/google\';\nimport \'./globals.css\';\n\nconst spaceGrotesk = Space_Grotesk({\n  subsets: [\'latin\'],\n  variable: \'--font-space-grotesk\',\n});\n\nconst sora = Sora({\n  subsets: [\'latin\'],\n  variable: \'--font-sora\',\n});\n\nexport const metadata: Metadata = {\n  title: \'Brands & Beyond 2025\',\n  description: \'Ideas today. Impact tomorrow.\',\n};\n\nexport default function RootLayout({children}: {children: React.ReactNode}) {\n  return (\n    <html lang=\"en\" className={`${spaceGrotesk.variable} ${sora.variable} scroll-smooth`}>\n      <body suppressHydrationWarning>{children}</body>\n    </html>\n  );\n}\nEOF\n\ncat << \'EOF\' > app/globals.css\n@import \"tailwindcss\";\n@import \"tw-animate-css\";\n\n@theme {\n  --color-brand-navy: #15162b;\n  --color-brand-navy2: #211e51;\n  --color-brand-purple: #5d28b8;\n  --color-brand-magenta: #c3219d;\n  --color-brand-pink: #ef3db5;\n  --color-brand-cyan: #38d9ee;\n  --color-brand-yellow: #f2dc57;\n  --color-brand-cream: #fbf9f6;\n  --color-brand-ink: #191a2c;\n  --font-sans: var(--font-space-grotesk), ui-sans-serif, system-ui, sans-serif;\n  --font-cond: var(--font-sora), ui-sans-serif, system-ui, sans-serif;\n}\n\nbody {\n  background-color: var(--color-brand-cream);\n  color: var(--color-brand-ink);\n  -webkit-font-smoothing: antialiased;\n}\n\n::selection {\n  background-color: var(--color-brand-magenta);\n  color: #fff;\n}\nEOF\n\ncat << \'EOF\' > components/hero.tsx\n\'use client\';\n\nimport { motion, useScroll, useTransform } from \'motion/react\';\nimport Image from \'next/image\';\nimport { useRef } from \'react\';\n\nexport default function Hero() {\n  const containerRef = useRef(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start start\", \"end start\"]\n  });\n\n  const yText = useTransform(scrollYProgress, [0, 1], [\"0%\", \"40%\"]);\n  const opacityText = useTransform(scrollYProgress, [0, 1], [1, 0]);\n  const scaleImg = useTransform(scrollYProgress, [0, 1], [1, 1.05]);\n\n  return (\n    <section ref={containerRef} className=\"relative pt-[120px] md:pt-[180px] pb-[40px] px-[4vw] md:px-[6vw] min-h-[90svh] flex flex-col items-center justify-center bg-brand-cream overflow-hidden\">\n       \n       <motion.div style={{ y: yText, opacity: opacityText }} className=\"text-center z-10 relative max-w-5xl mx-auto mb-12 md:mb-20\">\n          <motion.div \n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.6, ease: \"easeOut\" }}\n            className=\"inline-flex items-center gap-3 px-5 py-2 rounded-full bg-brand-magenta/10 text-brand-magenta font-sans text-xs md:text-sm font-semibold tracking-wide uppercase mb-6\"\n          >\n            <span className=\"w-2 h-2 rounded-full bg-brand-magenta animate-pulse\" />\n            Kathmandu \342\200\242 4-5 September 2025\n          </motion.div>\n          \n          <motion.h1 \n            initial={{ opacity: 0, y: 30 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.1, ease: \"easeOut\" }}\n            className=\"font-cond text-[12vw] md:text-[7vw] leading-[1.05] tracking-tight text-brand-navy mb-6 font-bold\"\n          >\n            Ideas today.<br />\n            <span className=\"text-brand-magenta\">Impact tomorrow.</span>\n          </motion.h1>\n          \n          <motion.p \n            initial={{ opacity: 0, y: 30 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2, ease: \"easeOut\" }}\n            className=\"font-sans text-[#555] text-base md:text-xl max-w-2xl mx-auto leading-relaxed\"\n          >\n            A platform for bold ideas, meaningful conversations and the people shaping a more innovative, inclusive and impactful future.\n          </motion.p>\n          \n          <motion.div \n            initial={{ opacity: 0, y: 30 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.3, ease: \"easeOut\" }}\n            className=\"flex flex-col sm:flex-row items-center justify-center gap-4 mt-10\"\n          >\n            <a href=\"#packages\" className=\"px-8 py-4 w-full sm:w-auto text-center rounded-full bg-brand-magenta text-white font-cond text-sm font-semibold tracking-wide hover:bg-brand-pink hover:shadow-lg hover:-translate-y-1 transition-all\">\n              Secure Your Spot\n            </a>\n            <a href=\"#story\" className=\"px-8 py-4 w-full sm:w-auto text-center rounded-full border border-brand-navy/20 text-brand-navy bg-white/50 backdrop-blur-sm font-cond text-sm font-semibold tracking-wide hover:bg-brand-navy hover:text-white hover:-translate-y-1 transition-all\">\n              Discover the Agenda\n            </a>\n          </motion.div>\n       </motion.div>\n\n       <motion.div \n         className=\"relative w-full max-w-7xl mx-auto h-[45vh] md:h-[60vh] rounded-[2rem] md:rounded-[4rem] overflow-hidden shadow-2xl\"\n         initial={{ opacity: 0, y: 60 }}\n         animate={{ opacity: 1, y: 0 }}\n         transition={{ duration: 1.2, delay: 0.4, ease: [0.16, 1, 0.3, 1] }}\n       >\n         <motion.div style={{ scale: scaleImg }} className=\"w-full h-full\">\n           <Image \n             src=\"https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=2400&q=80\" \n             alt=\"Event Stage\" \n             fill \n             className=\"object-cover\" \n             referrerPolicy=\"no-referrer\"\n             priority\n           />\n         </motion.div>\n         \n         <div className=\"absolute inset-0 bg-gradient-to-t from-brand-navy/80 via-transparent to-transparent pointer-events-none\" />\n         \n         <div className=\"absolute bottom-6 md:bottom-12 left-6 md:left-12 text-white font-cond\">\n            <div className=\"text-4xl md:text-6xl font-bold mb-1\">500+</div>\n            <div className=\"text-sm md:text-lg opacity-90 font-sans tracking-wide\">Global Attendees</div>\n         </div>\n       </motion.div>\n    </section>\n  );\n}\nEOF\n\ncat << \'EOF\' > components/ui.tsx\n\'use client\';\n\nimport { motion, useScroll, useTransform, useInView, useSpring } from \'motion/react\';\nimport { useEffect, useRef } from \'react\';\nimport Link from \'next/link\';\n\nexport function Navbar() {\n  const { scrollY } = useScroll();\n  const background = useTransform(\n    scrollY,\n    [0, 50],\n    [\'rgba(251,249,246,0)\', \'rgba(255,255,255,0.9)\']\n  );\n  const backdropFilter = useTransform(\n    scrollY,\n    [0, 50],\n    [\'blur(0px)\', \'blur(16px)\']\n  );\n  const border = useTransform(\n    scrollY,\n    [0, 50],\n    [\'1px solid rgba(255,255,255,0)\', \'1px solid rgba(0,0,0,0.05)\']\n  );\n  const boxShadow = useTransform(\n    scrollY,\n    [0, 50],\n    [\'none\', \'0 4px 20px rgba(0,0,0,0.03)\']\n  );\n\n  const scrollTo = (e: React.MouseEvent<HTMLAnchorElement>, id: string) => {\n    e.preventDefault();\n    const element = document.getElementById(id);\n    if (element) {\n      const y = element.getBoundingClientRect().top + window.scrollY - 80;\n      window.scrollTo({ top: y, behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <motion.header\n      style={{ background, backdropFilter, border, boxShadow }}\n      className=\"fixed z-[100] top-4 left-1/2 -translate-x-1/2 w-[92%] md:w-auto max-w-6xl rounded-full h-[60px] md:h-[72px] flex items-center justify-between px-6 md:px-8 text-brand-navy\"\n      initial={{ y: -100, opacity: 0 }}\n      animate={{ y: 0, opacity: 1 }}\n      transition={{ duration: 0.8, ease: \'easeOut\' }}\n    >\n      <Link href=\"#\" className=\"font-cond text-[18px] font-bold tracking-tight shrink-0 flex items-center gap-2\">\n        <span className=\"w-4 h-4 rounded-full bg-brand-magenta inline-block\"></span>\n        Brands & Beyond\n      </Link>\n      <nav className=\"hidden md:flex gap-8 items-center mx-8 font-sans text-[13px] font-semibold tracking-wide\">\n        {[\'story\', \'people\', \'experience\', \'packages\'].map((id) => (\n          <a\n            key={id}\n            href={`#${id}`}\n            onClick={(e) => scrollTo(e, id)}\n            className=\"opacity-70 hover:opacity-100 hover:text-brand-magenta transition-all duration-300 capitalize\"\n          >\n            {id === \'story\' ? \'About\' : id === \'people\' ? \'Speakers\' : id === \'experience\' ? \'Sessions\' : \'Tickets\'}\n          </a>\n        ))}\n      </nav>\n      <div className=\"flex gap-3 shrink-0\">\n        <a\n          href=\"#packages\"\n          onClick={(e) => scrollTo(e, \'packages\')}\n          className=\"py-[10px] px-[24px] rounded-full border border-brand-navy bg-brand-navy text-white font-cond text-[12px] font-bold tracking-wide hover:bg-brand-magenta hover:border-brand-magenta transition-colors whitespace-nowrap shadow-sm\"\n        >\n          Register\n        </a>\n      </div>\n    </motion.header>\n  );\n}\n\nexport function Ticker() {\n  return (\n    <div className=\"h-16 bg-brand-navy text-white flex items-center overflow-hidden font-cond font-semibold text-[14px] tracking-widest uppercase\">\n      <motion.div\n        className=\"flex w-max gap-[60px] pr-[60px]\"\n        animate={{ x: [\"0%\", \"-50%\"] }}\n        transition={{ repeat: Infinity, ease: \"linear\", duration: 25 }}\n      >\n        {[...Array(6)].map((_, i) => (\n          <div key={i} className=\"flex gap-[60px] items-center\">\n            <span>Ideas today</span>\n            <span className=\"w-2 h-2 rounded-full bg-brand-magenta\" />\n            <span>Impact tomorrow</span>\n            <span className=\"w-2 h-2 rounded-full bg-brand-cyan\" />\n            <span className=\"text-brand-yellow\">Brands & Beyond</span>\n            <span className=\"w-2 h-2 rounded-full bg-brand-magenta\" />\n            <span>Kathmandu</span>\n            <span className=\"w-2 h-2 rounded-full bg-brand-cyan\" />\n          </div>\n        ))}\n      </motion.div>\n    </div>\n  );\n}\n\nexport function AnimatedNumber({ value, suffix = \"\" }: { value: number, suffix?: string }) {\n  const ref = useRef(null);\n  const isInView = useInView(ref, { once: true, margin: \"-10%\" });\n  const spring = useSpring(0, { bounce: 0, duration: 2000 });\n  const display = useTransform(spring, (current) => Math.round(current) + suffix);\n\n  useEffect(() => {\n    if (isInView) {\n      spring.set(value);\n    }\n  }, [isInView, spring, value]);\n\n  return <motion.b ref={ref} className=\"block font-cond font-bold text-[56px] tracking-tighter text-brand-navy leading-none\">{display}</motion.b>;\n}\n\nexport function Footer() {\n  return (\n    <footer className=\"bg-brand-navy text-white pt-[100px] px-[7vw] pb-[40px] rounded-t-[3rem] mt-[-2rem] relative z-10\">\n      <div className=\"grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-[60px] max-w-7xl mx-auto\">\n        <div>\n          <Link href=\"#\" className=\"font-cond text-[28px] font-bold tracking-tight block mb-4 flex items-center gap-3\">\n            <span className=\"w-5 h-5 rounded-full bg-brand-magenta inline-block\"></span>\n            Brands & Beyond\n          </Link>\n          <p className=\"text-[14px] text-white/60 leading-relaxed max-w-[350px] font-sans mt-6\">\n            A platform for bold ideas, meaningful connections and the people shaping a stronger tomorrow.\n          </p>\n        </div>\n        <div>\n          <h4 className=\"font-cond text-[13px] font-bold uppercase tracking-widest text-brand-yellow mb-6\">Explore</h4>\n          {[\'About\', \'Speakers\', \'Sessions\', \'Tickets\'].map((item) => (\n            <Link key={item} href={`#`} className=\"block font-sans text-[14px] my-3 text-white/70 hover:text-white hover:translate-x-1 transition-all\">\n              {item}\n            </Link>\n          ))}\n        </div>\n        <div>\n          <h4 className=\"font-cond text-[13px] font-bold uppercase tracking-widest text-brand-yellow mb-6\">Connect</h4>\n          {[\'Instagram\', \'LinkedIn\', \'Facebook\', \'Contact us\'].map((item) => (\n            <Link key={item} href={`#`} className=\"block font-sans text-[14px] my-3 text-white/70 hover:text-white hover:translate-x-1 transition-all\">\n              {item}\n            </Link>\n          ))}\n        </div>\n      </div>\n      <div className=\"border-t border-white/10 mt-[80px] pt-[30px] text-[12px] text-white/40 flex flex-col md:flex-row justify-between gap-4 font-sans max-w-7xl mx-auto\">\n        <span>\302\251 2025 Brands & Beyond</span>\n        <span>4\342\200\2235 September \302\267 The Plaza, Lalitpur</span>\n      </div>\n    </footer>\n  );\n}\nEOF\n\nsed -i \'s/<Image /<Image referrerPolicy=\"no-referrer\" /g\' components/sections.tsx\nsed -i \'s/text-\\[clamp(58px,7vw,115px)\\]/text-[clamp(42px,6vw,90px)]/g\' components/sections.tsx\nsed -i \'s/text-\\[clamp(55px,8vw,120px)\\]/text-[clamp(40px,7vw,95px)]/g\' components/sections.tsx\nsed -i \'s/text-\\[55px\\]/text-[42px]/g\' components/sections.tsx\nsed -i \'s/text-\\[60px\\] md:text-\\[80px\\]/text-[46px] md:text-[64px]/g\' components/sections.tsx\nsed -i \'s/text-\\[58px\\] md:text-\\[72px\\]/text-[42px] md:text-[56px]/g\' components/sections.tsx\n"
  }
}
