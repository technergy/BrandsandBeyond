        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# 7. Optional official authentic-control mapping\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
