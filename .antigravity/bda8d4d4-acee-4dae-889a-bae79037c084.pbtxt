        }
        lines {
          text: "        \"def _load_doctamper_model():\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    if not DOCTAMPER_READY:\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
