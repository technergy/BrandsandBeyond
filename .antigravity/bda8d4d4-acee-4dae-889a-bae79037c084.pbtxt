          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        \\\"field_name\\\": m.get(\\\"field_name\\\"),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        \\\"assigned_tool\\\": m.get(\\\"assigned_tool\\\"),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        \\\"original_value\\\": m.get(\\\"original_value\\\"),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        \\\"forged_value\\\": m.get(\\\"forged_value\\\"),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
