        }
        lines {
          text: "        \"## 21. McNemar significance test\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"McNemar\'s exact test is used only when two detectors produce paired binary decisions on the **same held-out samples**.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"For pixel-level continuous outputs, use paired bootstrap or permutation analysis rather than pretending McNemar is a pixel-level test.\\n\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"cell_type\": \"code\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"execution_count\": null,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"id\": \"ypZcddjA601_\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"metadata\": {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"id\": \"ypZcddjA601_\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"outputs\": [],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"source\": ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# 21. Exact paired McNemar test\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"def exact_mcnemar(y,a,b):\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    y=np.asarray(y).astype(int)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    a=np.asarray(a).astype(int)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    b=np.asarray(b).astype(int)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    b01=np.sum((a==y)&(b!=y))\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    b10=np.sum((a!=y)&(b==y))\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    n=int(b01+b10)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    if n==0:\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        return {\\\"b01\\\":int(b01),\\\"b10\\\":int(b10),\\\"p\\\":1.0}\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    p=2*binomtest(min(b01,b10),n,p=.5,alternative=\\\"two-sided\\\").pvalue\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    return {\\\"b01\\\":int(b01),\\\"b10\\\":int(b10),\\\"p\\\":float(min(1.0,p))}\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"print(\\\"McNemar requires two complete paired image-level prediction sets.\\\")\\n\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"cell_type\": \"markdown\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
