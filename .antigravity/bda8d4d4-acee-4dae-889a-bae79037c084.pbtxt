        }
        lines {
          text: "        \"        \\\"image_path\\\": str(image),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        \\\"mask_path\\\": str(mask),\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        \\\"label\\\": 1,\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        \\\"official_split\\\": split_raw,\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
