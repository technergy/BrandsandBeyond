  file_change {
    absolute_path_uri: "file:///components/sections.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\'use client\';\n\nimport { motion, useMotionTemplate, useMotionValue } from \'motion/react\';\nimport Image from \'next/image\';\nimport { AnimatedNumber } from \'./ui\';\nimport React, { useRef } from \'react\';\n\nconst FadeUp = ({ children, delay = 0, className = \"\" }: { children: React.ReactNode, delay?: number, className?: string }) => (\n  <motion.div\n    initial={{ opacity: 0, y: 45, scale: 0.98 }}\n    whileInView={{ opacity: 1, y: 0, scale: 1 }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 0.75, delay, ease: \"easeOut\" }}\n    className={className}\n  >\n    {children}\n  </motion.div>\n);\n\nconst RevealHeading = ({ children, className = \"\" }: { children: React.ReactNode, className?: string }) => (\n  <motion.div\n    initial={{ y: 65, opacity: 0, clipPath: \"inset(18% 0 0 0)\" }}\n    whileInView={{ y: 0, opacity: 1, clipPath: \"inset(0% 0 0 0)\" }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}\n    className={className}\n  >\n    {children}\n  </motion.div>\n);\n\nconst SectionKicker = ({ children }: { children: React.ReactNode }) => (\n  <motion.div\n    initial={{ x: -28, opacity: 0 }}\n    whileInView={{ x: 0, opacity: 1 }}\n    viewport={{ once: true, margin: \"-10%\" }}\n    transition={{ duration: 0.7, ease: \"easeOut\" }}\n    className=\"font-cond text-[11px] font-semibold tracking-[0.25em] uppercase text-brand-magenta mb-4\"\n  >\n    {children}\n  </motion.div>\n);\n\n// 3D Card effect component\nfunction TiltCard({ children, className = \"\" }: { children: React.ReactNode, className?: string }) {\n  const ref = useRef<HTMLDivElement>(null);\n  const mouseX = useMotionValue(0);\n  const mouseY = useMotionValue(0);\n\n  const rotateX = useMotionTemplate`${mouseY}deg`;\n  const rotateY = useMotionTemplate`${mouseX}deg`;\n\n  function handleMouseMove({ currentTarget, clientX, clientY }: React.MouseEvent) {\n    const { left, top, width, height } = currentTarget.getBoundingClientRect();\n    const x = (clientX - left - width / 2) / 25;\n    const y = -(clientY - top - height / 2) / 25;\n    mouseX.set(x);\n    mouseY.set(y);\n  }\n\n  function handleMouseLeave() {\n    mouseX.set(0);\n    mouseY.set(0);\n  }\n\n  return (\n    <motion.div\n      ref={ref}\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n      style={{ rotateX, rotateY, transformStyle: \"preserve-3d\" }}\n      className={`relative hover:shadow-[0_24px_55px_rgba(24,20,50,0.18)] transition-shadow duration-500 ${className}`}\n    >\n      {children}\n    </motion.div>\n  );\n}\n\nexport function Story() {\n  return (\n    <section id=\"story\" className=\"py-[75px] md:py-[110px] px-[6vw] md:px-[7vw] bg-brand-cream relative\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center\">\n        <FadeUp>\n          <SectionKicker>01 / About Brands &amp; Beyond</SectionKicker>\n          <RevealHeading>\n            <h2 className=\"font-cond text-[clamp(58px,7vw,115px)] leading-[0.78] tracking-[-0.045em] uppercase my-[18px]\">\n              Empowering<br/><span className=\"text-brand-magenta\">brands</span><br/>for what\'s <span className=\"text-[#2935a8]\">next.</span>\n            </h2>\n          </RevealHeading>\n          <p className=\"text-[13px] leading-[1.8] max-w-[480px] text-[#555663]\">\n            A platform for bold ideas, meaningful conversations and the people shaping a more innovative, inclusive and impactful tomorrow.\n          </p>\n          <div className=\"flex gap-[8px] mt-[25px]\">\n            <a href=\"#people\" className=\"font-cond text-[11px] uppercase tracking-[0.1em] py-[10px] px-[15px] border border-brand-magenta bg-brand-magenta text-white hover:bg-brand-pink hover:border-brand-pink transition-colors\">\n              Explore speakers\n            </a>\n            <a href=\"#experience\" className=\"font-cond text-[11px] uppercase tracking-[0.1em] py-[10px] px-[15px] border border-[#222] hover:bg-[#222] hover:text-white transition-colors\">\n              Explore sessions\n            </a>\n          </div>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[320px] bg-[#11152d] overflow-hidden group cursor-pointer\">\n            <Image src=\"https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&w=1200&q=85\" alt=\"Event video\" fill className=\"object-cover group-hover:scale-105 transition-transform duration-700\" />\n            <div className=\"absolute inset-0 bg-gradient-to-b from-transparent to-[#0a0b1b]/65 via-transparent\" />\n            <motion.div \n              className=\"absolute left-[20px] bottom-[18px] w-[42px] h-[42px] rounded-full bg-brand-magenta flex items-center justify-center text-[13px] text-white z-10\"\n              whileHover={{ scale: 1.15, backgroundColor: \"var(--color-brand-pink)\" }}\n            >\n              \342\226\266\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n      <div className=\"grid grid-cols-2 md:grid-cols-4 border-t border-[#d4d1cb] mt-[50px] md:mt-[85px] pt-[24px] gap-[20px]\">\n        <FadeUp delay={0.1} className=\"flex flex-col\"><AnimatedNumber value={10} suffix=\"+\" /><span className=\"font-cond text-[10px] tracking-[0.18em] uppercase text-[#777]\">Speakers</span></FadeUp>\n        <FadeUp delay={0.2} className=\"flex flex-col\"><AnimatedNumber value={10} suffix=\"+\" /><span className=\"font-cond text-[10px] tracking-[0.18em] uppercase text-[#777]\">Sessions</span></FadeUp>\n        <FadeUp delay={0.3} className=\"flex flex-col\"><AnimatedNumber value={20} suffix=\"+\" /><span className=\"font-cond text-[10px] tracking-[0.18em] uppercase text-[#777]\">Sponsors</span></FadeUp>\n        <FadeUp delay={0.4} className=\"flex flex-col\"><AnimatedNumber value={500} suffix=\"+\" /><span className=\"font-cond text-[10px] tracking-[0.18em] uppercase text-[#777]\">Delegates</span></FadeUp>\n      </div>\n    </section>\n  );\n}\n\nconst speakers = [\n  { img: \"https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=500&q=85\", name: \"Keynote Voice\", role: \"Brand Leader\" },\n  { img: \"https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=500&q=85\", name: \"Creative Voice\", role: \"Creative Director\" },\n  { img: \"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=500&q=85\", name: \"Growth Voice\", role: \"Business Leader\" },\n  { img: \"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=500&q=85\", name: \"Future Voice\", role: \"Strategist\" },\n  { img: \"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=500&q=85\", name: \"Culture Voice\", role: \"Founder\" },\n  { img: \"https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=500&q=85\", name: \"Impact Voice\", role: \"Entrepreneur\" },\n];\n\nconst advisors = [\n  { img: \"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=500&q=85\", name: \"Advisor One\", role: \"Industry\" },\n  { img: \"https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=500&q=85\", name: \"Advisor Two\", role: \"Brand\" },\n  { img: \"https://images.unsplash.com/photo-1504593811423-6dd665756598?auto=format&fit=crop&w=500&q=85\", name: \"Panel One\", role: \"Leadership\" },\n  { img: \"https://images.unsplash.com/photo-1504257432389-52343af06ae3?auto=format&fit=crop&w=500&q=85\", name: \"Panel Two\", role: \"Innovation\" },\n  { img: \"https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=500&q=85\", name: \"Panel Three\", role: \"Culture\" },\n  { img: \"https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=500&q=85\", name: \"Panel Four\", role: \"Growth\" },\n];\n\nexport function People() {\n  return (\n    <section id=\"people\" className=\"py-[75px] md:py-[110px] px-[6vw] md:px-[7vw] bg-[linear-gradient(145deg,#15164a,#252071_60%,#411c5d)] text-white relative overflow-hidden\">\n      <div className=\"absolute w-[70vw] h-[70vw] border border-brand-cyan/15 rounded-full -left-[25vw] -top-[10vw]\" />\n      \n      <div className=\"relative text-center mb-[65px]\">\n        <SectionKicker><span className=\"text-brand-yellow\">02 / The voices</span></SectionKicker>\n        <RevealHeading>\n          <h2 className=\"font-cond text-[clamp(55px,8vw,120px)] leading-[0.8] tracking-[-0.045em] uppercase m-0\">\n            People<br/>who move.\n          </h2>\n        </RevealHeading>\n      </div>\n\n      <div className=\"relative grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[60px] max-w-[1050px] mx-auto\">\n        <div>\n          <h3 className=\"font-cond text-[17px] tracking-[0.12em] uppercase border-b border-white/18 pb-[10px] m-0 mb-[22px]\">\n            Speakers <span className=\"text-brand-pink\">2025</span>\n          </h3>\n          <div className=\"grid grid-cols-3 gap-[12px]\">\n            {speakers.map((person, i) => (\n              <FadeUp key={i} delay={i * 0.05}>\n                <motion.div \n                  className=\"bg-[#f7f5ef] text-[#141525] p-[7px_7px_10px] text-center cursor-pointer shadow-transparent hover:shadow-[0_18px_35px_rgba(0,0,0,0.18)]\"\n                  whileHover={{ y: -8, rotate: -1 }}\n                  transition={{ type: \"spring\", stiffness: 300 }}\n                >\n                  <div className=\"w-full aspect-square relative overflow-hidden mb-2\">\n                    <Image src={person.img} alt={person.name} fill className=\"object-cover grayscale-[0.8]\" />\n                  </div>\n                  <b className=\"block font-cond text-[11px] uppercase\">{person.name}</b>\n                  <small className=\"text-[7px] text-[#7a7b84]\">{person.role}</small>\n                </motion.div>\n              </FadeUp>\n            ))}\n          </div>\n        </div>\n\n        <div>\n          <h3 className=\"font-cond text-[17px] tracking-[0.12em] uppercase border-b border-white/18 pb-[10px] m-0 mb-[22px]\">\n            Advisors <span className=\"text-brand-pink\">+ Panels</span>\n          </h3>\n          <div className=\"grid grid-cols-3 gap-[12px]\">\n            {advisors.map((person, i) => (\n              <FadeUp key={i} delay={0.2 + (i * 0.05)}>\n                <motion.div \n                  className=\"bg-[#f7f5ef] text-[#141525] p-[7px_7px_10px] text-center cursor-pointer shadow-transparent hover:shadow-[0_18px_35px_rgba(0,0,0,0.18)]\"\n                  whileHover={{ y: -8, rotate: -1 }}\n                  transition={{ type: \"spring\", stiffness: 300 }}\n                >\n                  <div className=\"w-full aspect-square relative overflow-hidden mb-2\">\n                    <Image src={person.img} alt={person.name} fill className=\"object-cover grayscale-[0.8]\" />\n                  </div>\n                  <b className=\"block font-cond text-[11px] uppercase\">{person.name}</b>\n                  <small className=\"text-[7px] text-[#7a7b84]\">{person.role}</small>\n                </motion.div>\n              </FadeUp>\n            ))}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport function Experience() {\n  return (\n    <section id=\"experience\" className=\"bg-white text-brand-ink px-[6vw] md:px-[7vw]\">\n      {/* Feature 1 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px] border-b border-[#ddd]\">\n        <FadeUp>\n          <SectionKicker>03 / Why participate?</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond text-[55px] leading-[0.82] uppercase tracking-[-0.04em] my-[12px]\">Ideas that<br/>leave a mark.</h3></RevealHeading>\n          <p className=\"text-[13px] leading-[1.8] text-[#666] max-w-[470px]\">\n            Move beyond passive listening. Meet the people behind the ideas, challenge assumptions and build conversations that continue after the event.\n          </p>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[330px] overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1200&q=85\" alt=\"Stage\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-full bg-brand-yellow text-[#111] font-cond text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 2.8, ease: \"easeInOut\", yoyo: true }}\n            >\n              CONNECT<br/>CREATE<br/>MOVE\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n\n      {/* Feature 2 (Reversed on md) */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px] border-b border-[#ddd]\">\n        <FadeUp delay={0.2} className=\"order-2 md:order-1\">\n          <TiltCard className=\"h-[330px] overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1475721027785-f74eccf877e2?auto=format&fit=crop&w=1200&q=85\" alt=\"Masterclass\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-full bg-brand-cyan text-[#111] font-cond text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 3.15, ease: \"easeInOut\", yoyo: true, delay: 0.5 }}\n            >\n              LEARN<br/>BUILD<br/>APPLY\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n        <FadeUp className=\"order-1 md:order-2\">\n          <SectionKicker>04 / Masterclass sessions</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond text-[55px] leading-[0.82] uppercase tracking-[-0.04em] my-[12px]\">Go deeper.<br/>Make it real.</h3></RevealHeading>\n          <p className=\"text-[13px] leading-[1.8] text-[#666] max-w-[470px]\">\n            Focused sessions designed around practical knowledge, sharp perspectives and useful takeaways for the people building brands.\n          </p>\n        </FadeUp>\n      </div>\n\n      {/* Feature 3 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-[40px] md:gap-[8vw] items-center py-[80px]\">\n        <FadeUp>\n          <SectionKicker>05 / A musical session</SectionKicker>\n          <RevealHeading><h3 className=\"font-cond text-[55px] leading-[0.82] uppercase tracking-[-0.04em] my-[12px]\">Ideas have<br/>a rhythm.</h3></RevealHeading>\n          <p className=\"text-[13px] leading-[1.8] text-[#666] max-w-[470px]\">\n            A more human event experience: music, culture and unexpected moments woven between conversations.\n          </p>\n        </FadeUp>\n        <FadeUp delay={0.2}>\n          <TiltCard className=\"h-[330px] overflow-hidden relative group\">\n            <div className=\"absolute inset-[16px] border border-white/55 z-[2] pointer-events-none\" />\n            <Image src=\"https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&w=1200&q=85\" alt=\"Music\" fill className=\"object-cover transition-transform duration-1000 group-hover:scale-105\" />\n            <motion.div \n              className=\"absolute z-[3] right-[18px] bottom-[18px] w-[100px] h-[100px] rounded-full bg-brand-magenta text-white font-cond text-[13px] text-center flex flex-col justify-center leading-tight shadow-lg\"\n              animate={{ y: [-8, 8], rotate: [-12, -4] }}\n              transition={{ repeat: Infinity, duration: 3.5, ease: \"easeInOut\", yoyo: true, delay: 1 }}\n            >\n              FEEL<br/>THE<br/>MOMENT\n            </motion.div>\n          </TiltCard>\n        </FadeUp>\n      </div>\n    </section>\n  );\n}\n\nexport function Audience() {\n  const chips = [\"Brand Leaders\", \"Marketing Teams\", \"Creative Directors\", \"Founders\", \"Entrepreneurs\", \"Strategists\", \"Product Leaders\", \"Young Professionals\"];\n  \n  return (\n    <section className=\"bg-[linear-gradient(135deg,#b91693,#e42eb3)] text-white text-center py-[100px] px-[7vw] relative overflow-hidden\">\n      <SectionKicker><span className=\"text-brand-yellow\">06 / Who should attend?</span></SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond text-[60px] md:text-[80px] leading-[0.8] uppercase tracking-[-0.05em] my-[15px] mb-[35px]\">\n          Built for people<br/>who move.\n        </h2>\n      </RevealHeading>\n      <div className=\"flex flex-wrap justify-center gap-[8px] max-w-[850px] mx-auto\">\n        {chips.map((chip, i) => (\n          <motion.span\n            key={chip}\n            initial={{ y: 22, opacity: 0, scale: 0.92 }}\n            whileInView={{ y: 0, opacity: 1, scale: 1 }}\n            viewport={{ once: true, margin: \"-10%\" }}\n            transition={{ duration: 0.5, delay: i * 0.055, type: \"spring\", bounce: 0.4 }}\n            whileHover={{ y: -3, backgroundColor: \"#ffffff\", color: \"var(--color-brand-purple)\" }}\n            className=\"border border-white/65 rounded-full py-[8px] px-[14px] font-cond text-[12px] uppercase tracking-[0.08em] cursor-pointer transition-colors duration-300\"\n          >\n            {chip}\n          </motion.span>\n        ))}\n      </div>\n    </section>\n  );\n}\n\nexport function Schedule() {\n  const schedule = [\n    { time: \"09:00\", session: \"Registration & Networking\", track: \"Community\" },\n    { time: \"10:00\", session: \"Opening Keynote\", track: \"Ideas\" },\n    { time: \"11:30\", session: \"Brand Transformation\", track: \"Brands\" },\n    { time: \"13:00\", session: \"Lunch & Connections\", track: \"Community\" },\n    { time: \"14:30\", session: \"Masterclass Sessions\", track: \"Deep Dive\" },\n    { time: \"16:30\", session: \"Panel: What\'s Next?\", track: \"Future\" },\n  ];\n\n  return (\n    <section className=\"bg-brand-cream py-[75px] md:py-[110px] px-[6vw] md:px-[7vw]\">\n      <SectionKicker>08 / Event schedule</SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond text-[58px] md:text-[72px] uppercase leading-[0.8] tracking-[-0.05em] my-[15px] mb-[45px]\">\n          Two days.<br/>One movement.\n        </h2>\n      </RevealHeading>\n      <div className=\"max-w-[950px] mx-auto border border-[#ddd] bg-white\">\n        <div className=\"grid grid-cols-[1fr_2fr_1fr] p-[14px_18px] border-b border-[#e2e2e2] font-cond text-[12px] bg-brand-purple text-white uppercase tracking-[0.12em]\">\n          <div>Time</div><div>Session</div><div>Track</div>\n        </div>\n        {schedule.map((row, i) => (\n          <FadeUp key={i} delay={i * 0.05}>\n            <div className=\"grid grid-cols-[1fr_2fr_1fr] p-[14px_18px] border-b border-[#e2e2e2] font-cond text-[12px] hover:bg-[#fafafa] transition-colors last:border-b-0\">\n              <div>{row.time}</div><div className=\"font-bold\">{row.session}</div><div className=\"text-[#666]\">{row.track}</div>\n            </div>\n          </FadeUp>\n        ))}\n      </div>\n    </section>\n  );\n}\n\nexport function Packages() {\n  return (\n    <section id=\"packages\" className=\"bg-white py-[75px] md:py-[110px] px-[6vw] md:px-[7vw]\">\n      <SectionKicker>07 / Delegate packages</SectionKicker>\n      <RevealHeading>\n        <h2 className=\"font-cond text-[58px] md:text-[72px] uppercase leading-[0.8] tracking-[-0.05em] my-[15px] mb-[45px]\">\n          Choose your<br/>way in.\n        </h2>\n      </RevealHeading>\n      \n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-[15px]\">\n        <FadeUp delay={0.1}>\n          <motion.div \n            className=\"p-[30px_24px] border border-[#ddd] relative overflow-hidden bg-[#ff9b00] text-white shadow-transparent cursor-pointer\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(30,25,60,0.16)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] uppercase m-0\">Standard</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 18,000</div>\n            <p className=\"text-[11px] leading-[1.6]\">Full event access, sessions, networking and delegate materials.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[9px_14px] font-cond text-[10px] uppercase mt-[15px] hover:bg-white hover:text-[#ff9b00] transition-colors\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n\n        <FadeUp delay={0.2}>\n          <motion.div \n            className=\"p-[30px_24px] border border-[#ddd] relative overflow-hidden bg-[#14b97b] text-white shadow-transparent cursor-pointer\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(30,25,60,0.16)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] uppercase m-0\">Premium</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 24,000</div>\n            <p className=\"text-[11px] leading-[1.6]\">Priority seating, premium networking access and additional experiences.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[9px_14px] font-cond text-[10px] uppercase mt-[15px] hover:bg-white hover:text-[#14b97b] transition-colors\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n\n        <FadeUp delay={0.3}>\n          <motion.div \n            className=\"p-[30px_24px] border border-[#ddd] relative overflow-hidden bg-[#2782e7] text-white shadow-transparent cursor-pointer\"\n            whileHover={{ y: -9, rotate: -0.5, boxShadow: \"0 22px 45px rgba(30,25,60,0.16)\" }}\n          >\n            <h3 className=\"font-cond text-[31px] uppercase m-0\">VIP</h3>\n            <div className=\"font-cond text-[42px] font-bold my-[25px]\">NPR 35,000</div>\n            <p className=\"text-[11px] leading-[1.6]\">VIP access, premium hospitality and high-level networking opportunities.</p>\n            <a href=\"#\" className=\"inline-block border border-current p-[9px_14px] font-cond text-[10px] uppercase mt-[15px] hover:bg-white hover:text-[#2782e7] transition-colors\">Register \342\206\222</a>\n          </motion.div>\n        </FadeUp>\n      </div>\n    </section>\n  );\n}"
    }
