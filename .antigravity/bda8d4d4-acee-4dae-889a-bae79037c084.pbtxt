        }
        lines {
          text: "        \"        y_true_b = (y_true >= 1).astype(np.uint8)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"        tp = int(np.sum((y_pred == 1) & (y_true_b == 1)))\\n\","
