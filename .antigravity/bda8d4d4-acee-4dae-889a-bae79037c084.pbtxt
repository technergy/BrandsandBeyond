      full: "\'use client\';import { motion, useScroll, useTransform, useInView, useSpring } from \'motion/react\';import { useEffect, useRef } from \'react\';import Link from \'next/link\';export function Navbar() {  const { scrollY } = useScroll();  const background = useTransform(    scrollY,    [0, 50],    [\'rgba(15,16,38,0)\', \'rgba(15,16,38,0.72)\']  );  const backdropFilter = useTransform(    scrollY,    [0, 50],    [\'blur(0px)\', \'blur(13px)\']  );  const borderBottom = useTransform(    scrollY,    [0, 50],    [\'1px solid rgba(255,255,255,0)\', \'1px solid rgba(255,255,255,0.09)\']  );  const scrollTo = (e: React.MouseEvent<HTMLAnchorElement>, id: string) => {    e.preventDefault();    const element = document.getElementById(id);    if (element) {      const y = element.getBoundingClientRect().top + window.scrollY - 60;      window.scrollTo({ top: y, behavior: \'smooth\' });    }  };  return (    <motion.header      style={{ background, backdropFilter, borderBottom }}      className=\"fixed z-[100] top-0 left-0 w-full h-[60px] md:h-[72px] flex items-center justify-between px-4 md:px-[4vw] text-white\"      initial={{ y: -70, opacity: 0 }}      animate={{ y: 0, opacity: 1 }}      transition={{ duration: 0.8, ease: \'easeOut\' }}    >      <Link href=\"#\" className=\"font-cond text-[17px] font-bold leading-[0.75] tracking-tight shrink-0\">        brands &amp; beyond        <small className=\"block text-brand-pink font-sans text-[8px] font-bold tracking-widest mt-2\">          Ideas today. Impact tomorrow.        </small>      </Link>      <nav className=\"hidden md:flex gap-[22px] items-center font-cond text-[11px] font-bold uppercase tracking-widest\">        {[\'story\', \'people\', \'experience\', \'packages\'].map((id) => (          <a            key={id}            href={`#${id}`}            onClick={(e) => scrollTo(e, id)}            className=\"opacity-80 hover:opacity-100 hover:text-brand-yellow transition-all duration-300\"          >            {id === \'story\' ? \'About\' : id === \'people\' ? \'Speakers\' : id === \'experience\' ? \'Sessions\' : \'Tickets\'}          </a>        ))}      </nav>      <div className=\"flex gap-[7px] shrink-0\">        <a          href=\"#story\"          onClick={(e) => scrollTo(e, \'story\')}          className=\"hidden md:block py-[9px] px-[16px] rounded-none border border-white/65 font-cond font-bold text-[11px] tracking-widest uppercase hover:bg-white hover:text-black transition-colors whitespace-nowrap\"        >          2024        </a>        <a          href=\"#packages\"          onClick={(e) => scrollTo(e, \'packages\')}          className=\"py-[9px] px-[16px] rounded-none border border-brand-magenta bg-brand-magenta font-cond font-bold text-[11px] tracking-widest uppercase hover:bg-brand-pink hover:border-brand-pink transition-colors whitespace-nowrap\"        >          Register        </a>      </div>    </motion.header>  );}export function Ticker() {  return (    <div className=\"h-12 bg-brand-magenta text-white flex items-center overflow-hidden font-cond font-bold text-[12px] tracking-widest uppercase\">      <motion.div        className=\"flex w-max gap-[50px] pr-[50px]\"        animate={{ x: [\"0%\", \"-50%\"] }}        transition={{ repeat: Infinity, ease: \"linear\", duration: 18 }}      >        {[...Array(4)].map((_, i) => (          <div key={i} className=\"flex gap-[50px] items-center\">            <span>Ideas today</span>            <i className=\"text-brand-yellow not-italic font-sans\">\342\234\246</i>            <span>Impact tomorrow</span>            <i className=\"text-brand-yellow not-italic font-sans\">\342\234\246</i>            <span>Brands & Beyond</span>            <i className=\"text-brand-yellow not-italic font-sans\">\342\234\246</i>            <span>Kathmandu</span>            <i className=\"text-brand-yellow not-italic font-sans\">\342\234\246</i>          </div>        ))}      </motion.div>    </div>  );}export function AnimatedNumber({ value, suffix = \"\" }: { value: number, suffix?: string }) {  const ref = useRef(null);  const isInView = useInView(ref, { once: true, margin: \"-10%\" });  const spring = useSpring(0, { bounce: 0, duration: 2000 });  const display = useTransform(spring, (current) => Math.round(current) + suffix);  useEffect(() => {    if (isInView) {      spring.set(value);    }  }, [isInView, spring, value]);  return <motion.b ref={ref} className=\"block font-cond font-bold text-[50px] tracking-tight\">{display}</motion.b>;}export function Footer() {  return (    <footer className=\"bg-[#111226] text-white pt-[70px] px-[7vw] pb-[30px] rounded-none mt-0\">      <div className=\"grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-[50px]\">        <div>          <Link href=\"#\" className=\"font-cond text-[25px] font-bold leading-[0.75] tracking-tight block mb-4\">            brands &amp; beyond            <small className=\"block text-brand-pink font-sans font-bold text-[9px] tracking-widest mt-2\">              Ideas today. Impact tomorrow.            </small>          </Link>          <p className=\"text-[12px] text-[#9a9ba7] leading-[1.7] max-w-[350px] font-sans\">            A platform for bold ideas, meaningful connections and the people shaping a stronger tomorrow.          </p>        </div>        <div>          <h4 className=\"font-cond text-[13px] font-bold uppercase tracking-widest text-brand-yellow mb-4\">Explore</h4>          {[\'About\', \'Speakers\', \'Sessions\', \'Tickets\'].map((item) => (            <Link key={item} href={`#`} className=\"block font-sans text-[13px] my-[10px] text-[#d6d6dc] hover:text-white transition-colors\">              {item}            </Link>          ))}        </div>        <div>          <h4 className=\"font-cond text-[13px] font-bold uppercase tracking-widest text-brand-yellow mb-4\">Connect</h4>          {[\'Instagram\', \'LinkedIn\', \'Facebook\', \'Contact us\'].map((item) => (            <Link key={item} href={`#`} className=\"block font-sans text-[13px] my-[10px] text-[#d6d6dc] hover:text-white transition-colors\">              {item}            </Link>          ))}        </div>      </div>      <div className=\"border-t border-[#292a3c] mt-[50px] pt-[20px] text-[11px] text-[#737481] flex flex-col md:flex-row justify-between gap-4 font-sans\">        <span>\302\251 2025 Brands & Beyond</span>        <span>4\342\200\2235 September \302\267 The Plaza, Lalitpur</span>      </div>    </footer>  );}"
