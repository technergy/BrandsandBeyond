        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# 19. Per-generator and per-source analysis\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"def group_pixel_analysis(pred_df, detector_name, group_col):\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
