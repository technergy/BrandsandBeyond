        }
        lines {
          text: "        \"    }\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"def pixel_metrics(target, score, tau=.5):\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    y=target.reshape(-1).astype(np.uint8)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    p=score.reshape(-1).astype(float)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    pred=(p>=tau).astype(np.uint8)\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    tp=np.sum((pred==1)&(y==1))\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    fp=np.sum((pred==1)&(y==0))\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"    fn=np.sum((pred==0)&(y==1))\\n\","
