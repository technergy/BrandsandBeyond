        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"testing_images = root / \\\"TestingSet\\\" / \\\"images\\\"\\n\","
