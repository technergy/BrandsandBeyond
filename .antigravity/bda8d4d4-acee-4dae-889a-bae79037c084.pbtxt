    command_line: "cat << \'EOF\' > components/hero.tsx\n\'use client\';\n\nimport { motion, useScroll, useTransform } from \'motion/react\';\nimport Image from \'next/image\';\nimport { useRef, useState } from \'react\';\n\nconst leftCards = [\n  { img: \"https://images.unsplash.com/photo-1475721027785-f74eccf877e2?auto=format&fit=crop&w=900&q=85\", tag: \"The conversations\" },\n  { img: \"https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=900&q=85\", tag: \"The stage\" },\n  { img: \"https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&w=900&q=85\", tag: \"The audience\" },\n  { img: \"https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=900&q=85\", tag: \"The moment\" },\n  { img: \"https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=900&q=85\", tag: \"Together\" },\n  { img: \"https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=900&q=85\", tag: \"Ideas\" },\n];\n\nconst rightCards = [\n  { img: \"https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=900&q=85\", tag: \"The people\" },\n  { img: \"https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=900&q=85\", tag: \"The room\" },\n  { img: \"https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=900&q=85\", tag: \"The energy\" },\n  { img: \"https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&w=900&q=85\", tag: \"The stage\" },\n  { img: \"https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=900&q=85\", tag: \"The future\" },\n  { img: \"https://images.unsplash.com/photo-1475721027785-f74eccf877e2?auto=format&fit=crop&w=900&q=85\", tag: \"The ideas\" },\n];\n\nfunction HeroColumn({ items, direction = \"up\", speed = 34, className = \"\" }: any) {\n  const isUp = direction === \"up\";\n  const [isHovered, setIsHovered] = useState(false);\n\n  return (\n    <div\n      className={`absolute top-0 w-[94%] md:w-[80%] flex flex-col gap-[14px] will-change-transform pt-[90px] ${className}`}\n      onMouseEnter={() => setIsHovered(true)}\n      onMouseLeave={() => setIsHovered(false)}\n    >\n      <motion.div\n        className=\"flex flex-col gap-[14px]\"\n        animate={{ y: isUp ? [\"0%\", \"-50%\"] : [\"-50%\", \"0%\"] }}\n        transition={{ \n          repeat: Infinity, \n          ease: \"linear\", \n          duration: speed,\n        }}\n        style={{\n          animationPlayState: isHovered ? \'paused\' : \'running\'\n        }}\n      >\n        {[...items, ...items].map((item, i) => (\n          <motion.article\n            key={i}\n            className=\"h-[165px] md:h-[205px] rounded-none overflow-hidden relative flex-none bg-[#28283c] border border-white/5 group origin-center cursor-pointer\"\n            whileHover={{ scale: 1.035, rotate: -0.5, filter: \"saturate(1.18)\" }}\n            transition={{ duration: 0.5, ease: \"easeOut\" }}\n          >\n            <Image \n              src={item.img} \n              alt={item.tag} \n              fill \n              sizes=\"(max-width: 768px) 50vw, 25vw\"\n              className=\"object-cover saturate-[0.82] contrast-[1.06] transition-transform duration-1000 group-hover:scale-110\" \n              referrerPolicy=\"no-referrer\" \n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-[#08091a]/64 to-transparent to-[55%]\" />\n            <span className=\"absolute left-[12px] bottom-[12px] z-10 font-cond font-bold text-[10px] md:text-[11px] uppercase tracking-widest text-white transition-all duration-500 group-hover:translate-x-[5px] group-hover:text-brand-yellow\">\n              {item.tag}\n            </span>\n          </motion.article>\n        ))}\n      </motion.div>\n    </div>\n  );\n}\n\nexport default function Hero() {\n  const containerRef = useRef(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start start\", \"end start\"]\n  });\n\n  const leftY = useTransform(scrollYProgress, [0, 1], [\"0%\", \"-7%\"]);\n  const rightY = useTransform(scrollYProgress, [0, 1], [\"0%\", \"7%\"]);\n  const centerScale = useTransform(scrollYProgress, [0, 1], [1, 0.96]);\n  const centerOpacity = useTransform(scrollYProgress, [0, 1], [1, 0.72]);\n  const centerY = useTransform(scrollYProgress, [0, 1], [\"0px\", \"-70px\"]);\n  const waveY = useTransform(scrollYProgress, [0, 1], [\"0px\", \"-35px\"]);\n\n  return (\n    <section \n      ref={containerRef}\n      className=\"h-[100svh] min-h-[700px] md:min-h-[720px] relative overflow-hidden text-white bg-[radial-gradient(ellipse_at_50%_58%,rgba(99,37,167,0.35),transparent_34%),linear-gradient(125deg,#0e1026_0%,#17163a_47%,#0f1026_100%)] after:content-[\'\'] after:absolute after:inset-0 after:pointer-events-none after:z-[11] after:bg-[radial-gradient(circle_at_50%_45%,transparent_0_24%,rgba(8,9,25,0.18)_48%,rgba(8,9,25,0.48)_100%)]\"\n    >\n      <div className=\"absolute inset-0 opacity-[0.34] bg-[linear-gradient(90deg,rgba(7,8,24,0.95)_0%,transparent_28%,transparent_72%,rgba(7,8,24,0.95)_100%),radial-gradient(circle_at_50%_100%,rgba(195,33,157,0.18),transparent_45%)]\" />\n      \n      <div className=\"absolute inset-0 block md:grid md:grid-cols-[25%_50%_25%] gap-0\">\n        <motion.div style={{ y: leftY }} className=\"absolute md:relative w-[30%] md:w-full h-[75%] md:h-full top-[15%] md:top-0 left-[-5%] md:left-0 opacity-40 md:opacity-100 overflow-hidden before:content-[\'\'] before:absolute before:inset-0 before:z-[3] before:pointer-events-none before:bg-[linear-gradient(90deg,#101127_0%,transparent_20%,transparent_80%,rgba(21,22,43,0.7))]\">\n          <motion.div \n            className=\"absolute z-[5] top-[86px] md:top-[98px] left-[4vw] md:left-[3vw] text-brand-cyan font-cond font-extrabold leading-[0.75] tracking-tight drop-shadow-[0_7px_25px_rgba(0,0,0,0.25)] text-[40px] md:text-[clamp(50px,7vw,110px)]\"\n            animate={{ y: [0, -8, 0], opacity: 1, scale: 1 }}\n            transition={{ repeat: Infinity, duration: 4.8, ease: \"easeInOut\" }}\n            initial={{ opacity: 0, scale: 0.8 }}\n          >\n            2024\n          </motion.div>\n          <motion.div \n            className=\"absolute z-[5] top-[145px] md:top-[185px] left-[4vw] font-cond text-[8px] md:text-[13px] tracking-widest uppercase font-bold\"\n            initial={{ opacity: 0, y: 18 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ delay: 0.3 }}\n          >\n            The beginning\n          </motion.div>\n          <HeroColumn items={leftCards} direction=\"up\" speed={30} className=\"md:items-end left-[3%] md:left-[10%] top-0 md:top-0\" />\n        </motion.div>\n\n        <motion.div style={{ scale: centerScale, opacity: centerOpacity, y: centerY }} className=\"absolute inset-0 md:relative z-[20] md:z-[15] flex items-center justify-center text-center isolate before:content-[\'\'] before:absolute before:inset-[7%_8%] before:-z-[1] before:bg-[radial-gradient(ellipse_at_center,rgba(21,22,43,0.97)_0%,rgba(21,22,43,0.82)_48%,rgba(21,22,43,0)_78%)] before:blur-[4px] before:pointer-events-none after:content-[\'\'] after:absolute after:w-[42vw] after:h-[42vw] after:rounded-full after:bg-[radial-gradient(circle,rgba(195,33,157,0.14),transparent_64%)] after:blur-[15px] after:pointer-events-none\">\n          <div className=\"relative z-[2] w-[92%] md:w-[min(720px,96%)] mt-[20px] md:mt-[35px] p-[22px_12px] md:p-[28px_24px]\">\n            <motion.div \n              className=\"font-cond font-bold text-[9px] md:text-[12px] tracking-widest uppercase text-brand-yellow mb-[22px] flex items-center justify-center after:content-[\'\'] after:inline-block after:w-[38px] after:h-[1px] after:bg-brand-pink after:ml-[10px] after:origin-left\"\n              initial={{ opacity: 0, y: 18 }}\n              animate={{ opacity: 1, y: 0 }}\n              transition={{ delay: 0.3 }}\n            >\n              Brands & Beyond / Kathmandu\n            </motion.div>\n            <h1 className=\"font-cond font-extrabold text-[42px] sm:text-[52px] md:text-[clamp(56px,6vw,110px)] leading-[0.95] tracking-tighter m-0 uppercase flex items-center justify-center flex-wrap gap-x-2 md:gap-x-4\">\n              <motion.span initial={{ opacity: 0, y: 90, rotateX: -45 }} animate={{ opacity: 1, y: 0, rotateX: 0 }} transition={{ delay: 0.45, duration: 1 }}>Brands</motion.span>\n              <motion.span className=\"text-transparent\" style={{ WebkitTextStroke: \'1px rgba(255,255,255,0.92)\' }} initial={{ opacity: 0, y: 90, rotateX: -45 }} animate={{ opacity: 1, y: 0, rotateX: 0 }} transition={{ delay: 0.57, duration: 1 }}>& Beyond</motion.span>\n              <motion.span initial={{ opacity: 0, y: 90, rotateX: -45 }} animate={{ opacity: 1, y: 0, rotateX: 0 }} transition={{ delay: 0.69, duration: 1 }} className=\"mt-2 md:mt-0\">2025</motion.span>\n            </h1>\n            <motion.p \n              className=\"font-cond text-[12px] md:text-[15px] leading-[1.4] tracking-wider uppercase mx-auto mt-[28px] max-w-[280px] md:max-w-[420px] text-[#e5e4eb]\"\n              initial={{ opacity: 0, y: 18 }}\n              animate={{ opacity: 1, y: 0 }}\n              transition={{ delay: 0.8 }}\n            >\n              Empowering brands for what&apos;s next.\n            </motion.p>\n            <motion.div \n              className=\"font-sans font-medium text-[10px] md:text-[12px] tracking-widest uppercase mt-[23px] text-[#bfc0ca]\"\n              initial={{ opacity: 0, y: 18 }}\n              animate={{ opacity: 1, y: 0 }}\n              transition={{ delay: 0.88 }}\n            >\n              4\342\200\2235 September 2025 \302\267 The Plaza, Lalitpur\n            </motion.div>\n            <div className=\"flex flex-col md:flex-row justify-center items-center gap-[12px] mt-[32px] w-full mx-auto\">\n              <motion.a \n                href=\"#packages\" \n                className=\"font-cond text-[11px] md:text-[13px] font-bold uppercase tracking-widest p-[14px_28px] rounded-none border border-brand-magenta bg-brand-magenta hover:shadow-[0_12px_30px_rgba(195,33,157,0.28)] transition-all whitespace-nowrap w-full md:w-auto\"\n                initial={{ opacity: 0, y: 20, scale: 0.92 }}\n                animate={{ opacity: 1, y: 0, scale: 1 }}\n                transition={{ delay: 0.95 }}\n                whileHover={{ y: -4 }}\n              >\n                Register now \342\206\222\n              </motion.a>\n              <motion.a \n                href=\"#people\" \n                className=\"font-cond text-[11px] md:text-[13px] font-bold uppercase tracking-widest p-[14px_28px] rounded-none border border-white/60 hover:bg-white/10 transition-all whitespace-nowrap w-full md:w-auto\"\n                initial={{ opacity: 0, y: 20, scale: 0.92 }}\n                animate={{ opacity: 1, y: 0, scale: 1 }}\n                transition={{ delay: 1.03 }}\n                whileHover={{ y: -4 }}\n              >\n                Meet the voices\n              </motion.a>\n            </div>\n          </div>\n          <motion.div \n            className=\"absolute bottom-[25px] left-1/2 -translate-x-1/2 z-[5] font-cond text-[11px] tracking-widest uppercase font-bold text-[#c8c8d2] after:content-[\'\342\206\223\'] after:text-brand-yellow after:inline-block after:ml-[8px] after:text-[17px]\"\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            transition={{ delay: 1.2, duration: 1 }}\n          >\n            Scroll to explore\n          </motion.div>\n        </motion.div>\n\n        <motion.div style={{ y: rightY }} className=\"absolute md:relative w-[30%] md:w-full h-[75%] md:h-full top-[15%] md:top-0 right-[-5%] md:right-0 opacity-40 md:opacity-100 overflow-hidden before:content-[\'\'] before:absolute before:inset-0 before:z-[3] before:pointer-events-none before:bg-[linear-gradient(90deg,rgba(21,22,43,0.7),transparent_20%,transparent_80%,#101127)]\">\n          <motion.div \n            className=\"absolute z-[5] top-[86px] md:top-[98px] right-[4vw] md:right-[3vw] text-brand-yellow font-cond font-extrabold leading-[0.75] tracking-tight drop-shadow-[0_7px_25px_rgba(0,0,0,0.25)] text-[40px] md:text-[clamp(50px,7vw,110px)]\"\n            animate={{ y: [0, -8, 0], opacity: 1, scale: 1 }}\n            transition={{ repeat: Infinity, duration: 4.8, ease: \"easeInOut\", delay: -2.1 }}\n            initial={{ opacity: 0, scale: 0.8 }}\n          >\n            2025\n          </motion.div>\n          <motion.div \n            className=\"absolute z-[5] top-[145px] md:top-[185px] right-[4vw] text-right font-cond text-[8px] md:text-[13px] tracking-widest uppercase font-bold\"\n            initial={{ opacity: 0, y: 18 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ delay: 0.3 }}\n          >\n            The next chapter\n          </motion.div>\n          <HeroColumn items={rightCards} direction=\"down\" speed={27} className=\"md:items-start right-[3%] md:left-[10%] top-0 md:top-[-30%]\" />\n        </motion.div>\n      </div>\n\n      <motion.div style={{ y: waveY }} className=\"absolute z-[12] left-[-5%] right-[-5%] bottom-[12%] md:bottom-[15%] h-[100px] pointer-events-none\">\n        <svg viewBox=\"0 0 1200 100\" preserveAspectRatio=\"none\" className=\"w-full h-full\">\n          <motion.path \n            className=\"stroke-brand-cyan fill-none stroke-[1.1px]\" \n            d=\"M0 60 C180 10 260 100 430 50 S720 10 870 65 S1070 90 1200 30\"\n            strokeDasharray=\"7 12\"\n            animate={{ strokeDashoffset: -380 }}\n            transition={{ repeat: Infinity, duration: 12, ease: \"linear\" }}\n          />\n          <motion.path \n            className=\"stroke-brand-yellow fill-none stroke-[1.1px]\" \n            d=\"M0 65 C180 95 300 