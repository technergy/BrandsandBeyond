        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"DOCTAMPER_DIR = Path(os.environ.get(\\\"DOCTAMPER_DIR\\\", \\\"/content/DocTamper\\\"))\\n\","
