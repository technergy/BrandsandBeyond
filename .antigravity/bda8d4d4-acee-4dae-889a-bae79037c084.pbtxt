        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# 18. Create perturbation manifests\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"# ============================================================\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"ROBUST_DIR=Path(CFG.output_dir)/\\\"robust_inputs\\\"\\n\","
