          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"    // Wait for the data to be ready.\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"    let fileData = yield {\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"      promise: fileDataPromise,\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              \"      response: {\\n\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
