  file_change {
    absolute_path_uri: "file:///components/ui.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\'use client\';\n\nimport { motion, useScroll, useTransform, useInView, useSpring } from \'motion/react\';\nimport { useEffect, useRef } from \'react\';\nimport Link from \'next/link\';\n\nexport function Navbar() {\n  const { scrollY } = useScroll();\n  const background = useTransform(\n    scrollY,\n    [0, 50],\n    [\'rgba(15,16,38,0)\', \'rgba(15,16,38,0.72)\']\n  );\n  const backdropFilter = useTransform(\n    scrollY,\n    [0, 50],\n    [\'blur(0px)\', \'blur(13px)\']\n  );\n  const borderBottom = useTransform(\n    scrollY,\n    [0, 50],\n    [\'1px solid rgba(255,255,255,0)\', \'1px solid rgba(255,255,255,0.09)\']\n  );\n\n  const scrollTo = (e: React.MouseEvent<HTMLAnchorElement>, id: string) => {\n    e.preventDefault();\n    const element = document.getElementById(id);\n    if (element) {\n      const y = element.getBoundingClientRect().top + window.scrollY - 60;\n      window.scrollTo({ top: y, behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <motion.header\n      style={{ background, backdropFilter, borderBottom }}\n      className=\"fixed z-[100] top-0 left-0 w-full h-[60px] md:h-[72px] flex items-center justify-between px-4 md:px-[4vw] text-white\"\n      initial={{ y: -70, opacity: 0 }}\n      animate={{ y: 0, opacity: 1 }}\n      transition={{ duration: 0.8, ease: \'easeOut\' }}\n    >\n      <Link href=\"#\" className=\"font-cond text-[17px] font-bold leading-[0.75] tracking-[0.03em]\">\n        brands &amp; beyond\n        <small className=\"block text-brand-pink font-sans text-[7px] tracking-[0.2em] mt-2\">\n          Ideas today. Impact tomorrow.\n        </small>\n      </Link>\n      <nav className=\"hidden md:flex gap-[22px] items-center font-cond text-[11px] uppercase tracking-[0.12em]\">\n        {[\'story\', \'people\', \'experience\', \'packages\'].map((id) => (\n          <a\n            key={id}\n            href={`#${id}`}\n            onClick={(e) => scrollTo(e, id)}\n            className=\"opacity-80 hover:opacity-100 hover:text-brand-yellow transition-all duration-300\"\n          >\n            {id === \'story\' ? \'About\' : id === \'people\' ? \'Speakers\' : id === \'experience\' ? \'Sessions\' : \'Tickets\'}\n          </a>\n        ))}\n      </nav>\n      <div className=\"flex gap-[7px]\">\n        <a\n          href=\"#story\"\n          onClick={(e) => scrollTo(e, \'story\')}\n          className=\"hidden md:block py-[9px] px-[15px] border border-white/65 font-cond text-[11px] tracking-[0.08em] uppercase hover:bg-white hover:text-black transition-colors\"\n        >\n          2024\n        </a>\n        <a\n          href=\"#packages\"\n          onClick={(e) => scrollTo(e, \'packages\')}\n          className=\"py-[9px] px-[15px] border border-brand-magenta bg-brand-magenta font-cond text-[11px] tracking-[0.08em] uppercase hover:bg-brand-pink hover:border-brand-pink transition-colors\"\n        >\n          Register\n        </a>\n      </div>\n    </motion.header>\n  );\n}\n\nexport function Ticker() {\n  return (\n    <div className=\"h-12 bg-brand-magenta text-white flex items-center overflow-hidden font-cond font-semibold text-[12px] tracking-[0.16em] uppercase\">\n      <motion.div\n        className=\"flex w-max gap-[50px] pr-[50px]\"\n        animate={{ x: [\"0%\", \"-50%\"] }}\n        transition={{ repeat: Infinity, ease: \"linear\", duration: 18 }}\n      >\n        {[...Array(4)].map((_, i) => (\n          <div key={i} className=\"flex gap-[50px] items-center\">\n            <span>Ideas today</span>\n            <i className=\"text-brand-yellow not-italic\">\342\234\246</i>\n            <span>Impact tomorrow</span>\n            <i className=\"text-brand-yellow not-italic\">\342\234\246</i>\n            <span>Brands & Beyond</span>\n            <i className=\"text-brand-yellow not-italic\">\342\234\246</i>\n            <span>Kathmandu</span>\n            <i className=\"text-brand-yellow not-italic\">\342\234\246</i>\n          </div>\n        ))}\n      </motion.div>\n    </div>\n  );\n}\n\nexport function AnimatedNumber({ value, suffix = \"\" }: { value: number, suffix?: string }) {\n  const ref = useRef(null);\n  const isInView = useInView(ref, { once: true, margin: \"-10%\" });\n  const spring = useSpring(0, { bounce: 0, duration: 2000 });\n  const display = useTransform(spring, (current) => Math.round(current) + suffix);\n\n  useEffect(() => {\n    if (isInView) {\n      spring.set(value);\n    }\n  }, [isInView, spring, value]);\n\n  return <motion.b ref={ref} className=\"block font-cond text-[50px] tracking-tight\">{display}</motion.b>;\n}\n\nexport function Footer() {\n  return (\n    <footer className=\"bg-[#111226] text-white pt-[70px] px-[7vw] pb-[30px]\">\n      <div className=\"grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-[50px]\">\n        <div>\n          <Link href=\"#\" className=\"font-cond text-[25px] font-bold leading-[0.75] tracking-[0.03em] block mb-4\">\n            brands &amp; beyond\n            <small className=\"block text-brand-pink font-sans text-[9px] tracking-[0.2em] mt-2\">\n              Ideas today. Impact tomorrow.\n            </small>\n          </Link>\n          <p className=\"text-[11px] text-[#9a9ba7] leading-[1.7] max-w-[350px]\">\n            A platform for bold ideas, meaningful connections and the people shaping a stronger tomorrow.\n          </p>\n        </div>\n        <div>\n          <h4 className=\"font-cond text-[12px] uppercase tracking-[0.18em] text-brand-yellow mb-2\">Explore</h4>\n          {[\'About\', \'Speakers\', \'Sessions\', \'Tickets\'].map((item) => (\n            <Link key={item} href={`#`} className=\"block font-cond text-[12px] my-[9px] text-[#d6d6dc] hover:text-white transition-colors\">\n              {item}\n            </Link>\n          ))}\n        </div>\n        <div>\n          <h4 className=\"font-cond text-[12px] uppercase tracking-[0.18em] text-brand-yellow mb-2\">Connect</h4>\n          {[\'Instagram\', \'LinkedIn\', \'Facebook\', \'Contact us\'].map((item) => (\n            <Link key={item} href={`#`} className=\"block font-cond text-[12px] my-[9px] text-[#d6d6dc] hover:text-white transition-colors\">\n              {item}\n            </Link>\n          ))}\n        </div>\n      </div>\n      <div className=\"border-t border-[#292a3c] mt-[50px] pt-[20px] text-[9px] text-[#737481] flex flex-col md:flex-row justify-between gap-2\">\n        <span>\302\251 2025 Brands & Beyond</span>\n        <span>4\342\200\2235 September \302\267 The Plaza, Lalitpur</span>\n      </div>\n    </footer>\n  );\n}\n"
    }
